#!/usr/bin/env bash
set -euo pipefail

staged_ruby=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(rb|rake)$|Gemfile$' || true)

if [ -n "$staged_ruby" ] && [ -f Gemfile.lock ] && bundle exec rubocop --version >/dev/null 2>&1; then
  echo "pre-commit: rubocop on staged Ruby files"
  # shellcheck disable=SC2086
  bundle exec rubocop --force-exclusion $staged_ruby
else
  echo "pre-commit: rubocop skipped (no staged Ruby files or bundle not installed)"
fi

if git diff --cached --name-only | grep -vE '(^|/)\.env\.example$' | grep -qE '(^|/)\.env(\.|$)|master\.key$|credentials/.*\.key$'; then
  echo "pre-commit: refusing to commit secrets (.env / *.key)" >&2
  exit 1
fi
