# Rails 8
/.bundle
/vendor/bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules
/coverage
/spec/examples.txt

# Secrets
/config/master.key
/config/credentials/*.key
/.env*
!/.env.example

# Engines
/engines/*/log/*
/engines/*/tmp/*
/engines/*/spec/dummy/log/*
/engines/*/spec/dummy/tmp/*

# OS / editors
.DS_Store
*.swp
.idea/
