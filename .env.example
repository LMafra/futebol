# Copy to .env (bin/setup does it). Never commit real values.

# Database — development/test use DB_* + docker. Production (Render) reads SUPABASE_DATABASE_URL, falling back to
# DATABASE_URL; keep DATABASE_URL commented locally (Rails treats an empty DATABASE_URL as set and fails with
# "Database URL cannot be empty").
# Solid Cache/Queue/Cable default to <db>_cache, <db>_queue, <db>_cable on the same server; override if needed.
# DATABASE_URL=
# CACHE_DATABASE_URL=
# QUEUE_DATABASE_URL=
# CABLE_DATABASE_URL=
DB_HOST=localhost
DB_PORT=5440
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_CONTAINER=futebol-pg

# Supabase (production; Dashboard → Connect). Runtime: transaction pooler, port 6543 (prepared statements off):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DATABASE_URL=
# Migrations (db:prepare in bin/docker-entrypoint): session pooler, port 5432 — IPv4, unlike db.<ref>.supabase.co
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DIRECT_URL=

# Cloudflare R2 (Active Storage service :r2, config/storage.yml). ACTIVE_STORAGE_SERVICE=r2 in development
# uploads to R2_BUCKET_DEV; production defaults to r2 (set local only for a credential-less boot).
ACTIVE_STORAGE_SERVICE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: defaults to https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET_DEV=futebol-dev
R2_BUCKET_PROD=futebol-prod

# Resend (Action Mailer over SMTP: smtp.resend.com:465, user "resend", password = API key)
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Render (APP_HOST = public host for mailer links and host authorization; Render also sets RENDER_EXTERNAL_HOSTNAME)
APP_HOST=
RENDER_API_KEY=
RENDER_DEPLOY_HOOK_URL=

# Observability — OpenTelemetry traces + log records to OpenObserve over OTLP/HTTP (config/initializers/opentelemetry.rb)
# OTLP base URL of an OpenObserve organization; /v1/traces and /v1/logs are appended. Empty: development uses
# http://localhost:5080/api/default (docker, see README); production exports nothing; test never exports.
OPENOBSERVE_OTLP_ENDPOINT=
# Authorization header value: "Basic <base64 email:password>" (a bare base64 token gets "Basic " prepended)
OPENOBSERVE_AUTH=
# Set to true to turn the SDK off entirely (e.g. development without OpenObserve running)
OTEL_SDK_DISABLED=
