<section class="w-full rounded-md border border-rule bg-white p-4" <%= tag.attributes(root_attributes(label: "Orçamento")) %>>
  <p class="text-xs font-bold uppercase tracking-widest text-graphite">Orçamento</p>

  <% case state %>
  <% when :default %>
    <div class="mt-2 flex items-baseline justify-between gap-4 tabular-nums">
      <span class="font-semibold" data-role="budget-spent">Gasto <%= money(spent) %></span>
      <span class="text-sm <%= over_budget? ? 'font-bold text-ink' : 'text-graphite' %>" data-role="budget-remaining">
        <%= over_budget? ? "Estourou #{money(-remaining)}" : "Resta #{money(remaining)}" %> de <%= money(budget) %>
      </span>
    </div>
    <div class="mt-2 h-2 w-full overflow-hidden rounded-sm bg-rule" role="progressbar" aria-valuemin="0" aria-valuemax="<%= budget %>" aria-valuenow="<%= spent %>">
      <div class="h-2 <%= over_budget? ? 'bg-ink' : 'bg-cartola' %>" style="width: <%= percent %>%"></div>
    </div>
  <% when :loading %>
    <div class="mt-2 h-6 w-1/2 <%= skeleton_classes %>" data-role="skeleton" aria-hidden="true"></div>
    <div class="mt-2 h-2 w-full <%= skeleton_classes %>" aria-hidden="true"></div>
  <% when :empty %>
    <div class="mt-2"><%= empty_notice("Escolha jogadores para ver o orçamento.") %></div>
  <% when :error %>
    <div class="mt-2 <%= error_classes %>" role="alert">
      <span class="font-bold">Não foi possível calcular o orçamento.</span>
    </div>
  <% end %>
</section>
