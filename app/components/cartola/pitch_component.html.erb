<section class="w-full" <%= tag.attributes(root_attributes(label: "Campo")) %>>
  <% case state %>
  <% when :default %>
    <div class="flex flex-col gap-4 rounded-md bg-pitch px-4 py-6 text-white" data-role="pitch">
      <p class="text-xs font-bold uppercase tracking-widest text-rule" data-role="formation">Formação <span class="tabular-nums"><%= lineup.formation %></span></p>
      <% SLOTS.each do |slot, label| %>
        <div class="flex flex-col items-center gap-2" data-slot="<%= slot %>">
          <span class="sr-only"><%= label %></span>
          <ul class="flex flex-wrap justify-center gap-2">
            <% players_on(slot).each do |player| %>
              <li class="flex min-w-28 flex-col items-center rounded-sm bg-night px-3 py-2 text-center" data-role="pitch-player">
                <span class="text-sm font-semibold"><%= player.name %></span>
                <span class="text-xs text-rule"><%= player.position %> · <%= player.team&.short_name %></span>
                <% if price(player) %>
                  <span class="text-xs tabular-nums text-rule"><%= price(player) %></span>
                <% end %>
              </li>
            <% end %>
            <% open_slots(slot).times do %>
              <li class="flex min-w-28 items-center justify-center rounded-sm border border-dashed border-rule px-3 py-2 text-xs text-rule" data-role="pitch-open-slot">Vaga</li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% when :loading %>
    <span class="sr-only">Carregando escalação…</span>
    <div class="h-96 w-full <%= skeleton_classes %>" data-role="skeleton" aria-hidden="true"></div>
  <% when :empty %>
    <%= empty_notice("Nenhuma escalação para esta rodada.") %>
  <% when :error %>
    <div class="<%= error_classes %>" role="alert">
      <span class="font-bold">Não foi possível carregar a escalação.</span>
    </div>
  <% end %>
</section>
