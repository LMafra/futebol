<section class="w-full rounded-md border border-rule bg-white p-4" data-controller="player-filter" <%= tag.attributes(root_attributes(label: "Jogadores")) %>>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="text-xs font-bold uppercase tracking-widest text-graphite">Jogadores</p>
    <% if list? %>
      <label class="flex items-center gap-2 text-sm font-semibold">
        Posição
        <select class="<%= form_control_classes %>" data-action="player-filter#filter" data-role="position-filter">
          <option value="">Todas</option>
          <% POSITION_LABELS.each do |position, label| %>
            <option value="<%= position %>"><%= label %></option>
          <% end %>
        </select>
      </label>
    <% end %>
  </div>

  <% if error? %>
    <div class="mt-3 <%= error_classes %>" role="alert">
      <span class="font-bold">Revise a escalação: confira os limites por posição e o saldo.</span>
    </div>
  <% end %>

  <% if list? %>
    <input type="hidden" name="lineup[player_ids][]" value="">
    <p class="mt-2 text-sm text-graphite" data-role="captain-hint">Marque um capitão (C) entre os escalados: os pontos dele contam em dobro, inclusive os negativos.</p>
    <% POSITION_LABELS.each do |position, label| %>
      <% next unless players_by_position[position] %>
      <fieldset class="mt-4" data-player-filter-target="group" data-position="<%= position %>">
        <legend class="text-sm font-bold"><%= label %></legend>
        <ul class="mt-2 grid gap-1 sm:grid-cols-2">
          <% players_by_position[position].each do |player| %>
            <li class="flex items-center gap-2 rounded-sm px-2 py-1 hover:bg-rule/40">
              <label class="flex min-h-12 flex-1 cursor-pointer items-center justify-between gap-3">
                <span class="flex items-center gap-2">
                  <input type="checkbox" name="lineup[player_ids][]" value="<%= player.id %>" class="size-4 accent-pitch" <%= "checked" if selected?(player) %>>
                  <span><%= player.name %> <span class="text-sm text-graphite"><%= player.team&.short_name %></span></span>
                </span>
                <span class="text-sm tabular-nums text-graphite"><%= price(player) %></span>
              </label>
              <label class="cursor-pointer" title="Capitão: pontos em dobro">
                <input type="radio" name="lineup[captain_id]" value="<%= player.id %>" class="peer sr-only" <%= "checked" if captain_id == player.id %>
                       aria-label="Capitão: <%= player.name %>">
                <span class="flex size-12 items-center justify-center rounded-sm border border-graphite bg-white text-sm font-bold text-ink peer-checked:border-cartola peer-checked:bg-cartola peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink" aria-hidden="true">C</span>
              </label>
            </li>
          <% end %>
        </ul>
      </fieldset>
    <% end %>
  <% elsif loading? %>
    <div class="mt-3 flex flex-col gap-2" aria-hidden="true">
      <% 5.times do %>
        <div class="h-8 w-full <%= skeleton_classes %>" data-role="skeleton"></div>
      <% end %>
    </div>
  <% elsif empty? || players.blank? %>
    <div class="mt-3"><%= empty_notice("Nenhum jogador disponível.") %></div>
  <% end %>
</section>
