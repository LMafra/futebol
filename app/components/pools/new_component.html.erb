<section class="flex w-full max-w-xl flex-col gap-6" <%= tag.attributes(root_attributes(label: "Criar bolão")) %>>
  <header class="border-b-4 border-ink pb-2">
    <p class="text-xs font-bold uppercase tracking-widest text-graphite">Bolão</p>
    <h1 class="mt-1 font-display text-4xl font-extrabold tracking-tight">Criar bolão</h1>
  </header>

  <% if error? %>
    <div class="<%= error_classes %>" role="alert">
      <ul data-role="errors">
        <% error_messages.each do |message| %>
          <li class="font-bold"><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if loading? %>
    <span class="sr-only">Carregando formulário…</span>
    <div class="flex flex-col gap-3" aria-hidden="true">
      <div class="h-12 w-full <%= skeleton_classes %>" data-role="skeleton"></div>
      <div class="h-12 w-full <%= skeleton_classes %>" data-role="skeleton"></div>
      <div class="h-12 w-[8rem] <%= skeleton_classes %>" data-role="skeleton"></div>
    </div>
  <% elsif empty? %>
    <%= empty_notice("Nenhum campeonato disponível para criar um bolão.") %>
  <% elsif show_form? %>
    <%= form_with model: pool, url: pools_path, scope: :pool, class: "flex flex-col gap-4 rounded-md border border-rule bg-white p-4" do |form| %>
      <div class="flex flex-col gap-1">
        <%= form.label :name, "Nome", class: "text-sm font-semibold" %>
        <%= form.text_field :name, required: true, class: form_control_classes %>
        <% if (message = field_error(:name)) %>
          <p class="text-sm text-ink" data-role="field-error"><%= message %></p>
        <% end %>
      </div>
      <div class="flex flex-col gap-1">
        <%= form.label :championship_id, "Campeonato", class: "text-sm font-semibold" %>
        <%= form.collection_select :championship_id, championships, :id, :to_s, {}, class: form_control_classes %>
        <% if (message = field_error(:championship)) %>
          <p class="text-sm text-ink" data-role="field-error"><%= message %></p>
        <% end %>
      </div>
      <div class="flex items-center gap-4">
        <%= form.submit "Criar bolão", class: "cursor-pointer rounded-sm bg-pitch px-4 py-2 font-semibold text-white hover:bg-night" %>
        <%= link_to "Cancelar", pools_path, class: "text-graphite underline underline-offset-2 hover:no-underline" %>
      </div>
    <% end %>
  <% end %>
</section>
