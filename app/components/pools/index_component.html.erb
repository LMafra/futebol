<section class="flex w-full flex-col gap-6" <%= tag.attributes(root_attributes(label: "Meus bolões")) %>>
  <header class="flex flex-wrap items-end justify-between gap-4 border-b-4 border-ink pb-2">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-graphite">Bolão</p>
      <h1 class="mt-1 font-display text-4xl font-extrabold tracking-tight">Meus bolões</h1>
    </div>
    <%= link_to "Criar bolão", new_pool_path, class: primary_button_classes %>
  </header>

  <% if error? %>
    <div class="<%= error_classes %>" role="alert">
      <span id="pools-error" class="font-bold" data-role="error-message"><%= error_message %></span>
    </div>
  <% end %>

  <% if loading? %>
    <span class="sr-only">Carregando bolões…</span>
    <div class="flex flex-col gap-2" aria-hidden="true">
      <% 3.times do %>
        <div class="h-12 w-full <%= skeleton_classes %>" data-role="skeleton"></div>
      <% end %>
    </div>
  <% else %>
    <%= form_with url: join_pools_path, method: :post, class: "flex flex-wrap items-end gap-3 rounded-md border border-rule bg-white p-4", data: { role: "join-form" } do |form| %>
      <div class="flex flex-col gap-1">
        <%= form.label :code, "Entrar com código", class: "text-sm font-semibold" %>
        <%= form.text_field :code, maxlength: Bolao::Pool::CODE_LENGTH, required: true, autocomplete: "off", placeholder: "EX: K7P2QD",
                              class: form_control_classes("w-[10rem] font-semibold uppercase tabular-nums tracking-widest", invalid: join_error?),
                              aria: { invalid: join_error? || nil, describedby: ("pools-error" if join_error?) } %>
      </div>
      <%= form.submit "Entrar", class: secondary_button_classes %>
    <% end %>

    <% if empty? %>
      <%= empty_notice("Você ainda não participa de nenhum bolão.") %>
    <% elsif listed_pools.any? %>
      <ul class="divide-y divide-rule rounded-md border border-rule bg-white" data-role="pools">
        <% listed_pools.each do |pool| %>
          <li class="flex items-center justify-between gap-4 px-4 py-3">
            <div>
              <%= link_to pool.name, pool_path(pool), class: inline_link_classes %>
              <p class="text-sm text-graphite"><%= pool.championship %></p>
            </div>
            <span class="font-semibold tabular-nums tracking-widest text-graphite"><%= pool.code %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</section>
