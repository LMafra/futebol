<section class="flex w-full flex-col gap-6" <%= tag.attributes(root_attributes(label: "Meus bolões")) %>>
  <header class="flex flex-wrap items-end justify-between gap-4 border-b-4 border-ink pb-2">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-graphite">Bolão</p>
      <h1 class="mt-1 font-display text-4xl font-extrabold tracking-tight">Meus bolões</h1>
    </div>
  </header>

  <% if error? %>
    <div class="<%= error_classes %>" role="alert">
      <span id="pools-error" class="font-bold" data-role="error-message"><%= error_message %></span>
    </div>
  <% end %>

  <% if loading? %>
    <span class="sr-only">Carregando bolões…</span>
    <div class="flex flex-col gap-2" aria-hidden="true">
      <% 3.times do %>
        <div class="h-12 w-full <%= skeleton_classes %>" data-role="skeleton"></div>
      <% end %>
    </div>
  <% else %>
    <%= form_with url: join_pools_path, method: :post, class: "flex flex-wrap items-end gap-3 rounded-md border border-rule bg-white p-4", data: { role: "join-form" } do |form| %>
      <div class="flex flex-col gap-1">
        <%= form.label :code, "Entrar com código", class: "text-sm font-semibold" %>
        <%= form.text_field :code, maxlength: Bolao::Pool::CODE_LENGTH, required: true, autocomplete: "off", placeholder: "EX: K7P2QD",
                              class: form_control_classes("w-[10rem] font-semibold uppercase tabular-nums tracking-widest", invalid: join_error?),
                              aria: { invalid: join_error? || nil, describedby: ("pools-error" if join_error?) } %>
      </div>
      <%= form.submit "Entrar", class: secondary_button_classes %>
      <p class="basis-full text-sm text-graphite" data-role="join-hint">Os bolões são criados pelo gestor de cada campeonato. Peça o código a ele para entrar.</p>
    <% end %>

    <%= form_with url: pools_path, method: :get, class: "flex flex-wrap items-end gap-3", data: { role: "pools-search" } do |form| %>
      <div class="flex flex-col gap-1">
        <%= form.label :q, "Buscar por nome", class: "text-sm font-semibold" %>
        <%= form.search_field :q, value: query, placeholder: "Nome do bolão",
                               class: form_control_classes("min-w-[14rem]"),
                               data: { role: "pools-search-input" } %>
      </div>
      <%= form.submit "Buscar", class: secondary_button_classes, name: nil %>
    <% end %>

    <% if empty? || listed_cards.empty? %>
      <div data-role="pools-empty">
        <%= render Ui::EmptyStateComponent.new(title: empty_title, description: empty_description) %>
      </div>
    <% else %>
      <ul class="divide-y divide-rule rounded-md border border-rule bg-white" data-role="pools">
        <% listed_cards.each do |card| %>
          <li class="flex flex-wrap items-center justify-between gap-4 px-4 py-3" data-role="pool-card" data-pool-id="<%= card.pool.id %>">
            <div class="min-w-0">
              <%= link_to card.pool.name, pool_path(card.pool), class: inline_link_classes %>
              <p class="text-sm text-graphite">
                <%= card.pool.championship %> ·
                <span class="tabular-nums"><%= card.members_count %></span> membros
                <% if card.position %>
                  · Posição <span class="font-semibold tabular-nums text-ink"><%= card.position %></span>
                <% end %>
              </p>
            </div>
            <% if card.show_code %>
              <div class="flex items-center gap-2" data-controller="clipboard" data-role="pool-code">
                <code class="font-semibold tabular-nums tracking-widest text-graphite" data-clipboard-target="source"><%= card.pool.code %></code>
                <button type="button" class="<%= secondary_button_classes %>" data-action="clipboard#copy" data-clipboard-target="button">
                  Copiar código
                </button>
                <span class="sr-only" aria-live="polite" data-clipboard-target="status"></span>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</section>
