<section class="flex w-full flex-col gap-6" <%= tag.attributes(root_attributes(label: "Bolão")) %>>
  <% if pool %>
    <header class="flex flex-wrap items-end justify-between gap-4 border-b-4 border-ink pb-2">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-graphite"><%= pool.championship %></p>
        <h1 class="mt-1 font-display text-4xl font-extrabold tracking-tight"><%= pool.name %></h1>
      </div>
      <div class="text-right">
        <p class="text-xs font-bold uppercase tracking-widest text-graphite">Código</p>
        <p class="text-2xl font-bold tabular-nums tracking-widest" data-role="code"><%= pool.code %></p>
      </div>
    </header>
  <% end %>

  <% case state %>
  <% when :default %>
    <div class="rounded-md border border-rule bg-white">
      <h2 class="border-b border-rule px-4 py-2 text-sm font-bold uppercase tracking-widest text-graphite">
        Participantes <span class="tabular-nums">(<%= memberships.size %>)</span>
      </h2>
      <ul class="divide-y divide-rule" data-role="members">
        <% memberships.each do |membership| %>
          <li class="flex items-center justify-between gap-4 px-4 py-3">
            <span class="font-semibold"><%= member_label(membership) %></span>
            <span class="flex items-center gap-3 text-sm text-graphite">
              <% if owner?(membership) %>
                <span class="rounded-sm bg-win px-2 py-1 text-xs font-bold uppercase tracking-widest text-ink">Dono</span>
              <% end %>
              <span class="tabular-nums">desde <%= joined_on(membership) %></span>
            </span>
          </li>
        <% end %>
      </ul>
    </div>
  <% when :loading %>
    <span class="sr-only">Carregando bolão…</span>
    <div class="flex flex-col gap-2" aria-hidden="true">
      <% 4.times do %>
        <div class="h-12 w-full <%= skeleton_classes %>" data-role="skeleton"></div>
      <% end %>
    </div>
  <% when :empty %>
    <%= empty_notice("Bolão sem participantes.") %>
  <% when :error %>
    <div class="<%= error_classes %>" role="alert">
      <span class="font-bold">Não foi possível carregar o bolão.</span>
    </div>
  <% end %>

  <div class="flex flex-wrap items-center gap-4">
    <% if pool&.persisted? %>
      <%= link_to "Palpites", pool_bets_path(pool), class: "rounded-sm bg-pitch px-4 py-2 font-semibold text-white hover:bg-night" %>
    <% end %>
    <%= link_to "Voltar para meus bolões", pools_path, class: "font-semibold text-pitch underline underline-offset-2 hover:no-underline" %>
    <% if can_destroy? %>
      <%= button_to "Excluir bolão", pool_path(pool), method: :delete, form: { data: { turbo_confirm: "Excluir o bolão #{pool.name}?" } },
                    class: "cursor-pointer text-graphite underline underline-offset-2 hover:no-underline" %>
    <% end %>
  </div>
</section>
