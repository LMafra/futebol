<section class="flex w-full flex-col gap-3" <%= tag.attributes(root_attributes(label: "Meus palpites")) %>>
  <h2 class="font-display text-2xl font-bold">Meus palpites</h2>

  <% case state %>
  <% when :default %>
    <% if results.empty? %>
      <%= empty_notice("Você ainda não palpitou neste bolão.") %>
    <% else %>
      <table class="w-full rounded-md border border-rule bg-white text-left">
        <thead class="text-xs font-bold uppercase tracking-widest text-graphite">
          <tr class="border-b border-rule">
            <th class="px-4 py-2">Jogo</th>
            <th class="px-4 py-2 text-center">Palpite</th>
            <th class="px-4 py-2 text-center">Placar</th>
            <th class="px-4 py-2">Resultado</th>
            <th class="px-4 py-2 text-right">Pontos</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-rule">
          <% results.each do |result| %>
            <% match = result.prediction.match %>
            <tr data-role="my-bet" data-result="<%= result.result %>">
              <td class="px-4 py-2"><%= match.home_team.name %> <span class="text-graphite">×</span> <%= match.away_team.name %></td>
              <td class="px-4 py-2 text-center font-semibold tabular-nums"><%= guess(result) %></td>
              <td class="px-4 py-2 text-center tabular-nums"><%= final_score(match) %></td>
              <td class="px-4 py-2">
                <span class="inline-flex items-center gap-2 rounded-sm px-2 py-1 text-sm font-semibold <%= badge(result)[:tint] %>">
                  <span class="font-bold" aria-hidden="true"><%= badge(result)[:glyph] %></span><%= badge(result)[:label] %>
                </span>
              </td>
              <td class="px-4 py-2 text-right font-bold tabular-nums" data-role="points"><%= points(result) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% when :loading %>
    <span class="sr-only">Carregando palpites…</span>
    <div class="flex flex-col gap-2" aria-hidden="true">
      <% 4.times do %>
        <div class="h-12 w-full <%= skeleton_classes %>" data-role="skeleton"></div>
      <% end %>
    </div>
  <% when :empty %>
    <%= empty_notice("Você ainda não palpitou neste bolão.") %>
  <% when :error %>
    <div class="<%= error_classes %>" role="alert">
      <span class="font-bold">Não foi possível carregar seus palpites.</span>
    </div>
  <% end %>
</section>
