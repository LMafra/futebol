<% attrs = root_attributes(label: title || 'Seção') %>
<% attrs[:class] = 'mb-6 rounded-md border border-rule bg-paper' %>
<% attrs[:data] = (attrs[:data] || {}).merge(role: 'form-section') %>
<section <%= tag.attributes(attrs) %>>
  <% case rendered_state %>
  <% when :default %>
    <h3 class="border-b border-rule px-4 py-3 font-display text-xl text-ink"><%= title %></h3>
    <div class="space-y-4 px-4 py-5 font-body text-ink">
      <%= body %>
    </div>
  <% when :loading %>
    <span class="sr-only">Carregando seção…</span>
    <div class="space-y-3 px-4 py-5" aria-hidden="true">
      <div class="h-6 w-1/3 <%= skeleton_classes %>"></div>
      <div class="h-10 w-full <%= skeleton_classes %>"></div>
      <div class="h-10 w-full <%= skeleton_classes %>"></div>
    </div>
  <% when :empty %>
    <%= empty_notice('Nada para editar nesta seção.') %>
  <% when :error %>
    <div class="<%= error_classes %>" role="alert">
      <span class="font-bold">Não foi possível montar a seção.</span>
    </div>
  <% end %>
</section>
