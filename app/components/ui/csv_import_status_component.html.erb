<section class="w-full rounded-md border border-rule bg-white p-4" <%= tag.attributes(root_attributes(label: "Importação CSV")) %>>
  <p class="text-xs font-bold uppercase tracking-widest text-graphite">Importação CSV</p>

  <% case state %>
  <% when :default %>
    <div class="mt-2 flex items-baseline justify-between gap-4">
      <span class="font-semibold" data-role="status"><%= status_label %></span>
      <span class="text-sm tabular-nums text-graphite" data-role="rows"><%= rows_label %></span>
    </div>
  <% when :loading %>
    <div class="mt-2 flex items-baseline justify-between gap-4">
      <span class="font-semibold" data-role="status">Processando…</span>
      <span class="text-sm tabular-nums text-graphite" data-role="rows"><%= rows_label %></span>
    </div>
    <div class="mt-2 h-2 w-full overflow-hidden rounded-sm bg-rule" aria-hidden="true">
      <div class="h-2 w-1/3 animate-pulse bg-pitch motion-reduce:animate-none" data-role="skeleton"></div>
    </div>
  <% when :empty %>
    <div class="mt-2"><%= empty_notice("Nenhuma importação") %></div>
  <% when :error %>
    <div class="mt-2 <%= error_classes %>" role="alert">
      <span class="font-bold">Importação falhou.</span>
      <span data-role="error-message"><%= csv_import&.error_message.presence || "Erro desconhecido." %></span>
    </div>
  <% end %>
</section>
