<div class="flex flex-col gap-1" <%= tag.attributes(root_attributes(label: "Palpite")) %>>
  <% if error? %>
    <ul class="text-sm font-semibold text-ink" role="alert" data-role="errors">
      <% base_errors.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <% if form? %>
    <%= form_with model: prediction, scope: :prediction, url: form_url, class: "flex items-center gap-2" do |form| %>
      <%= form.hidden_field :match_id unless prediction.persisted? %>
      <%= form.number_field :home_guess, min: 0, required: true, class: guess_input_classes, aria: guess_aria("Gols do mandante") %>
      <span class="text-graphite" aria-hidden="true">×</span>
      <%= form.number_field :away_guess, min: 0, required: true, class: guess_input_classes, aria: guess_aria("Gols do visitante") %>
      <%= form.submit submit_label, class: primary_button_classes %>
    <% end %>
    <% if field_errors.any? %>
      <div id="<%= error_id %>" class="text-sm font-semibold text-ink">
        <% field_errors.each do |message| %>
          <p data-role="field-error"><%= message %></p>
        <% end %>
      </div>
    <% end %>
  <% elsif loading? %>
    <div class="flex items-center gap-2" aria-hidden="true">
      <span class="h-12 w-16 <%= skeleton_classes %>"></span>
      <span class="text-graphite">×</span>
      <span class="h-12 w-16 <%= skeleton_classes %>"></span>
      <button type="button" disabled class="<%= primary_button_classes %>">
        <span class="size-3 animate-spin rounded-full border-2 border-white border-t-transparent motion-reduce:animate-none" data-role="spinner"></span>
        Salvando…
      </button>
    </div>
  <% elsif empty? %>
    <p class="text-sm font-semibold text-graphite" data-role="closed">
      Palpites encerrados<% if saved_guess %> · seu palpite <span class="tabular-nums"><%= saved_guess %></span><% end %>
    </p>
  <% end %>
</div>
