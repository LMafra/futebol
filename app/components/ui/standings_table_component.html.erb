<section class="w-full" <%= tag.attributes(root_attributes(label: "Classificação")) %>>
  <% case rendered_state %>
  <% when :default %>
    <div class="overflow-x-auto" data-role="table-scroll">
    <table class="w-full border-collapse text-sm tabular-nums lining-nums">
      <thead class="bg-pitch text-paper">
        <tr class="text-xs font-bold uppercase tracking-widest">
          <th scope="col" class="px-2 py-2 text-left">#</th>
          <% if changes? %>
            <th scope="col" class="px-2 py-2 text-left"><abbr title="Variação de posição">±</abbr></th>
          <% end %>
          <th scope="col" class="px-2 py-2 text-left">Time</th>
          <th scope="col" class="px-2 py-2 text-right"><abbr title="Pontos">P</abbr></th>
          <th scope="col" class="px-2 py-2 text-right"><abbr title="Jogos">J</abbr></th>
          <th scope="col" class="px-2 py-2 text-right"><abbr title="Vitórias">V</abbr></th>
          <th scope="col" class="px-2 py-2 text-right"><abbr title="Empates">E</abbr></th>
          <th scope="col" class="px-2 py-2 text-right"><abbr title="Derrotas">D</abbr></th>
          <th scope="col" class="px-2 py-2 text-right"><abbr title="Saldo de gols">SG</abbr></th>
          <th scope="col" class="px-2 py-2 text-left">Últimos</th>
        </tr>
      </thead>
      <tbody>
        <% rows.each do |row| %>
          <tr class="border-b border-rule even:bg-white" data-role="standing-row" <%= tag.attributes(data: { zone: zone(row) }) %>>
            <td class="px-2 py-2 font-bold <%= position_classes(row) %>">
              <%= row.position %><% if zone(row) %><span class="ml-1 text-xs font-bold text-graphite" data-role="zone-label"><%= ZONES.dig(zone(row), :label) %></span><% end %>
            </td>
            <% if changes? %>
              <td class="px-2 py-2"><%= change_glyph(row.change) unless row.change.nil? %></td>
            <% end %>
            <th scope="row" class="px-2 py-2 text-left font-semibold">
              <% if row.team&.crest&.attached? %>
                <span class="inline-flex items-center gap-2"><%= team_crest(row.team, size: "size-6") %><%= row.team_name %></span>
              <% else %>
                <span class="mr-2 text-xs font-bold tracking-wide text-graphite"><%= row.short_name %></span><%= row.team_name %>
              <% end %>
            </th>
            <td class="px-2 py-2 text-right font-bold"><%= row.points %></td>
            <td class="px-2 py-2 text-right"><%= row.played %></td>
            <td class="px-2 py-2 text-right"><%= row.wins %></td>
            <td class="px-2 py-2 text-right"><%= row.draws %></td>
            <td class="px-2 py-2 text-right"><%= row.losses %></td>
            <td class="px-2 py-2 text-right"><%= goal_difference(row.goal_difference) %></td>
            <td class="px-2 py-2">
              <span class="flex gap-1"><% row.form.each do |result| %><%= form_glyph(result) %><% end %></span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  <% when :loading %>
    <span class="sr-only">Carregando classificação…</span>
    <div class="flex flex-col gap-1" aria-hidden="true">
      <% SKELETON_ROWS.times do %>
        <div class="h-8 w-full <%= skeleton_classes %>" data-role="skeleton"></div>
      <% end %>
    </div>
  <% when :empty %>
    <%= empty_notice(empty_message) %>
  <% when :error %>
    <div class="<%= error_classes %>" role="alert">
      <span class="font-bold">Não foi possível montar a classificação.</span>
      <% if log_path %>
        <%= link_to "Abrir o registro do erro", log_path, class: inline_link_classes(tone: :ink), data: { role: "log-link" } %>
      <% end %>
    </div>
  <% end %>
</section>
