<% attrs = root_attributes(label: title) %>
<% attrs[:class] = 'mb-6 rounded-md border border-rule bg-white' %>
<% attrs[:data] = (attrs[:data] || {}).merge(role: 'action-center') %>
<section <%= tag.attributes(attrs) %> aria-labelledby="action-center-title">
  <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-rule px-4 py-3">
    <h3 class="font-display text-xl text-ink" id="action-center-title"><%= title %></h3>
    <% if filter_urgency.present? %>
      <p class="text-sm font-body text-graphite" data-role="action-center-filter">
        Filtro: <%= urgency_label(filter_urgency) %>
      </p>
    <% end %>
  </div>
  <div class="px-4 py-3">
    <% case rendered_state %>
    <% when :default %>
      <% if empty_groups? || visible_groups.values.all?(&:empty?) %>
        <%= render Ui::EmptyStateComponent.new(
              title: 'Nada na central de ações',
              description: 'Tudo em dia por aqui. Os indicadores acima mostram o panorama.'
            ) %>
      <% else %>
        <div class="flex flex-col gap-6">
          <% visible_groups.each do |urgency, items| %>
            <% next if items.empty? %>
            <div data-role="action-center-group" data-urgency="<%= urgency %>">
              <h4 class="mb-2 text-xs font-body font-bold uppercase tracking-widest text-graphite">
                <%= urgency_label(urgency) %>
              </h4>
              <ul class="flex flex-col gap-2">
                <% items.each do |item| %>
                  <li class="flex flex-wrap items-center justify-between gap-3 rounded-md border border-rule bg-paper/40 px-3 py-2"
                      data-role="action-center-item" data-item-id="<%= item.id %>">
                    <div class="min-w-0">
                      <p class="font-body font-semibold text-ink"><%= item.title %></p>
                      <% if item.context.present? %>
                        <p class="text-sm font-body text-graphite"><%= item.context %></p>
                      <% end %>
                    </div>
                    <%= link_to item.action_text, item.action_path,
                                class: AdminHelper::ADMIN_BUTTON_CLASSES,
                                data: { role: 'action-center-cta' } %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      <% end %>
    <% when :loading %>
      <span class="sr-only">Carregando central de ações…</span>
      <div class="h-24 w-full <%= skeleton_classes %>" aria-hidden="true"></div>
    <% when :empty %>
      <%= render Ui::EmptyStateComponent.new(title: 'Nada na central de ações', description: 'Tudo em dia.') %>
    <% when :error %>
      <div class="<%= error_classes %>" role="alert">Não foi possível montar a central de ações.</div>
    <% end %>
  </div>
</section>
