<% step_ctas = {
     edit: ["Editar partida", ->(match) { edit_gestor_match_path(match) }],
     scouts: ["Registrar lances", ->(match) { gestor_match_path(match) }],
     finalize: ["Finalizar partida", ->(match) { gestor_match_path(match, modal: "finalize") }]
   }
   step_notes = { scoring: "Aguardando a pontuação", scored: "Concluída", reverted: "Aguardando nova pontuação" } %>
<section class="rounded-md border border-rule bg-white" aria-labelledby="match-queue-title" data-role="gestor-match-queue">
  <h3 class="border-b border-rule px-4 py-3 font-display text-xl text-ink" id="match-queue-title">Fila de partidas</h3>
  <div class="px-4 py-3">
    <% if queue.empty? %>
      <%= render Ui::EmptyStateComponent.new(title: "Nenhuma partida na fila.", description: "Agende uma partida para ela aparecer aqui.") %>
    <% else %>
      <div class="overflow-x-auto">
        <table class="data-table" data-role="gestor-match-queue-table">
          <thead>
            <tr>
              <th scope="col">Partida</th>
              <th scope="col" class="text-right">Início</th>
              <th scope="col">Status</th>
              <th scope="col">Próximo passo</th>
              <th scope="col"><span class="sr-only">Mais ações</span></th>
            </tr>
          </thead>
          <tbody>
            <% queue.each do |item| %>
              <% match = item.match %>
              <tr data-role="queue-match" data-match-id="<%= match.id %>" data-step="<%= item.step %>">
                <td class="font-semibold"><%= link_to match, gestor_match_path(match), class: "text-ink" %></td>
                <td class="whitespace-nowrap text-right tabular-nums"><%= l(match.match_date, format: "%d/%m %H:%M") %></td>
                <td><%= admin_match_status_badge(match, label: (item.step == :scoring ? "Pontuando" : nil)) %></td>
                <td>
                  <% if (cta = step_ctas[item.step]) %>
                    <%= link_to cta.first, cta.last.call(match), class: AdminHelper::ADMIN_BUTTON_CLASSES, data: { role: "queue-cta" } %>
                  <% else %>
                    <span class="<%= AdminHelper::ADMIN_MUTED_TEXT_CLASSES %>"><%= step_notes.fetch(item.step) %></span>
                  <% end %>
                </td>
                <td class="text-right">
                  <details class="inline-block text-left" data-role="queue-overflow">
                    <summary class="<%= AdminHelper::ADMIN_SECONDARY_BUTTON_CLASSES %> list-none" aria-label="Mais ações: <%= match %>">⋯</summary>
                    <ul class="mt-2 flex flex-col gap-1 text-sm font-body">
                      <li><%= link_to "Ver partida", gestor_match_path(match), class: "inline-flex min-h-10 items-center text-ink" %></li>
                      <% if match.scheduled? && item.step != :edit %>
                        <li><%= link_to "Editar partida", edit_gestor_match_path(match), class: "inline-flex min-h-10 items-center text-ink" %></li>
                      <% end %>
                      <% if match.may_revert_match? && authorized?(:revert, match) %>
                        <li><%= link_to "Reverter pontuação", scoring_path("matchreversal", match_id: match.id), class: "inline-flex min-h-10 items-center font-semibold text-ink", data: { role: "queue-revert" } %></li>
                      <% end %>
                    </ul>
                  </details>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</section>
