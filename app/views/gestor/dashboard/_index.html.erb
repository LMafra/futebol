<% championships = capture do %>
  <section class="mb-6" aria-labelledby="championships-title">
    <h3 class="mb-3 font-display text-xl text-ink" id="championships-title">Seus campeonatos (<%= overview.size %>)</h3>
    <% if overview.empty? %>
      <%= render Ui::EmptyStateComponent.new(
            title: "Você ainda não tem campeonatos",
            description: "Crie o primeiro e depois cadastre os times e agende as partidas."
          ) do |empty| %>
        <% empty.with_action do %>
          <%= link_to "Criar campeonato", new_gestor_championship_path, class: AdminHelper::ADMIN_BUTTON_CLASSES %>
        <% end %>
      <% end %>
    <% else %>
      <div class="grid gap-4 sm:grid-cols-2" data-role="gestor-championships">
        <% overview.each do |row| %>
          <% championship = row.championship %>
          <article class="rounded-md border border-rule border-l-[3px] border-l-pitch bg-white p-4" data-championship-id="<%= championship.id %>">
            <div class="flex items-start justify-between gap-3">
              <h4 class="font-display text-xl text-ink">
                <%= link_to championship, gestor_championship_path(championship), class: title_link_classes("text-ink") %>
              </h4>
              <span class="rounded-sm bg-rule px-2 py-0.5 text-xs font-body font-semibold uppercase tracking-wide text-ink">
                <%= championship.draft? ? "rascunho" : (championship.private? ? "privado" : "público") %>
              </span>
            </div>
            <dl class="mt-3 grid grid-cols-2 gap-2 font-body text-sm">
              <div>
                <dt class="text-xs uppercase tracking-widest text-graphite">Times</dt>
                <dd class="font-numeric text-2xl tabular-nums text-ink" data-counter="teams"><%= row.teams %></dd>
              </div>
              <div>
                <dt class="text-xs uppercase tracking-widest text-graphite">Jogadores</dt>
                <dd class="font-numeric text-2xl tabular-nums text-ink" data-counter="players"><%= row.players %></dd>
              </div>
              <div>
                <dt class="text-xs uppercase tracking-widest text-graphite">Partidas</dt>
                <dd class="font-numeric text-2xl tabular-nums text-ink" data-counter="matches"><%= row.matches %></dd>
                <dd class="text-xs text-graphite"><%= row.scheduled %> agendada<%= "s" unless row.scheduled == 1 %></dd>
              </div>
              <div>
                <dt class="text-xs uppercase tracking-widest text-graphite">Bolões</dt>
                <dd class="font-numeric text-2xl tabular-nums text-ink" data-counter="pools"><%= row.pools %></dd>
              </div>
            </dl>
            <p class="mt-3 flex flex-wrap gap-x-3 gap-y-1 font-body text-sm">
              <%= link_to "Agendar partida", new_gestor_match_path(match: { championship_id: championship.id }), class: inline_link_classes(tone: :ink) %>
              <% if championship.draft? %>
                <%= link_to "Continuar rascunho", edit_gestor_championship_path(championship, step: "revisao"), class: inline_link_classes(tone: :ink) %>
              <% else %>
                <%= link_to "Editar campeonato", edit_gestor_championship_path(championship), class: inline_link_classes(tone: :ink) %>
              <% end %>
            </p>
          </article>
        <% end %>
      </div>
    <% end %>
  </section>
<% end %>

<%= championships if overview.empty? %>

<div class="mb-2" data-role="gestor-dashboard-hero">
  <p class="font-body text-sm text-graphite">Console do gestor — pendências dos seus campeonatos.</p>
</div>

<div class="mb-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4" data-role="gestor-kpis">
  <%= render Ui::KpiCardComponent.new(
        value: kpis[:awaiting_finalization],
        label: "Partidas pendentes",
        action_text: "Filtrar central",
        action_path: gestor_root_path(urgency: "high"),
        status: kpis[:awaiting_finalization].zero? ? :zero : :alert,
        data_role: "gestor-kpi"
      ) %>
  <%= render Ui::KpiCardComponent.new(
        value: kpis[:awaiting_scouts],
        label: "Aguardando lances",
        action_text: "Filtrar central",
        action_path: gestor_root_path(urgency: "critical"),
        status: kpis[:awaiting_scouts].zero? ? :zero : :alert,
        data_role: "gestor-kpi"
      ) %>
  <%= render Ui::KpiCardComponent.new(
        value: kpis[:next_round_hours].nil? ? 0 : "#{kpis[:next_round_hours]}h",
        label: "Próxima rodada",
        action_text: kpis[:next_round_hours].nil? ? nil : "Ver fila",
        action_path: kpis[:next_round_hours].nil? ? nil : gestor_root_path(urgency: "medium"),
        status: kpis[:next_round_hours].nil? ? :zero : :normal,
        data_role: "gestor-kpi"
      ) %>
  <%= render Ui::KpiCardComponent.new(
        value: kpis[:inconsistencies],
        label: "Inconsistências",
        action_text: "Filtrar central",
        action_path: gestor_root_path(urgency: "high"),
        status: kpis[:inconsistencies].zero? ? :zero : :alert,
        data_role: "gestor-kpi"
      ) %>
</div>

<%= render Ui::ActionCenterComponent.new(
      groups: action_groups,
      filter_urgency: urgency,
      title: "Central de ações"
    ) %>

<div class="mb-6">
  <%= render "gestor/dashboard/match_queue", queue: queue %>
</div>

<section class="mb-6 rounded-md border border-rule bg-white" aria-labelledby="upcoming-matches-title" data-role="gestor-upcoming-matches">
  <h3 class="border-b border-rule px-4 py-3 font-display text-xl text-ink" id="upcoming-matches-title">Próximas partidas</h3>
  <div class="px-4 py-3">
    <%= render Ui::AdminTableComponent.new(
          headers: ["Partida", "Início", "Situação"],
          rows: upcoming_matches.map { |match|
            [
              link_to(match.to_s, gestor_match_path(match), class: inline_link_classes(tone: :ink)),
              l(match.match_date, format: "%d/%m %H:%M"),
              admin_match_status_badge(match)
            ]
          },
          texts: { label: "Próximas partidas", empty: "Nenhuma partida agendada." },
          table_role: "upcoming-matches"
        ) %>
  </div>
</section>

<%= championships unless overview.empty? %>
