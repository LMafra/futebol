<% content_for(:title, brand_title("Minha conta")) %>

<section class="max-w-xl">
  <%= render "shared/flash" %>

  <p class="text-xs font-bold uppercase tracking-widest text-graphite">Conta</p>
  <h1 class="mt-1 border-b-4 border-ink pb-2 font-display text-4xl font-extrabold tracking-tight">Minha conta</h1>

  <dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2" data-role="account-data">
    <dt class="font-semibold">Nome</dt>
    <dd><%= @user.name.presence || "—" %></dd>
    <dt class="font-semibold">E-mail</dt>
    <dd><%= @user.email_address %></dd>
    <dt class="font-semibold">Nos rankings públicos</dt>
    <dd data-role="public-name"><%= @user.public_display_name %></dd>
  </dl>

  <div class="mt-8 border-t border-rule pt-6" data-role="manager-request">
    <h2 class="font-display text-xl font-bold">Acesso de gestor</h2>
    <% if @user.admin? || @user.manager? %>
      <p class="mt-2 text-sm text-graphite">Você já tem acesso de gestor.</p>
    <% elsif @user.manager_pending? %>
      <p class="mt-2 text-sm text-graphite">
        Pedido em análise (<%= Core::User.human_enum_name(:manager_status, @user.manager_status) %>).
        Você recebe um e-mail quando um administrador decidir.
      </p>
    <% elsif @user.manager_rejected? %>
      <p class="mt-2 text-sm text-graphite">
        Seu último pedido não foi aprovado (<%= Core::User.human_enum_name(:manager_status, @user.manager_status) %>).
      </p>
      <p class="mt-2">
        <%= link_to "Solicitar novamente", new_manager_request_path,
                    class: "text-sm font-semibold underline underline-offset-2 hover:no-underline" %>
      </p>
    <% else %>
      <p class="mt-2 text-sm text-graphite">Você ainda não solicitou acesso de gestor.</p>
      <p class="mt-2">
        <%= link_to "Solicitar acesso de gestor", new_manager_request_path,
                    class: "text-sm font-semibold underline underline-offset-2 hover:no-underline" %>
      </p>
    <% end %>
  </div>

  <%= form_with url: account_path, method: :patch, class: "mt-8 flex flex-col gap-4 border-t border-rule pt-6" do %>
    <div class="flex items-start gap-2">
      <%= hidden_field_tag :public_profile_consent, "0", id: nil %>
      <%= check_box_tag :public_profile_consent, "1", @user.public_profile_consented?, class: "mt-1 size-4 accent-pitch" %>
      <%= label_tag :public_profile_consent, t("public_profile_consent.label"), class: "text-sm" %>
    </div>
    <div>
      <%= submit_tag "Salvar", name: nil, class: "cursor-pointer rounded-sm bg-cartola px-4 py-2 font-bold text-ink transition-colors duration-fast ease-editorial hover:bg-pitch hover:text-white" %>
    </div>
  <% end %>
</section>
