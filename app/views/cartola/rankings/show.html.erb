<% content_for(:title, brand_title("Rankings do #{module_label(:fantasy)}")) %>

<div class="flex max-w-3xl flex-col gap-6">
  <header class="flex flex-wrap items-end justify-between gap-4 border-b-4 border-ink pb-2">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-graphite"><%= module_label(:fantasy) %><%= " · #{@championship}" if @championship %></p>
      <h1 class="mt-1 font-display text-4xl font-extrabold tracking-tight">Rankings</h1>
    </div>
    <% if @championships.size > 1 %>
      <%= form_with url: main_app.esquadrao_rankings_path, method: :get, class: "flex items-center gap-2 text-sm font-semibold" do %>
        <%= hidden_field_tag :tab, @tab %>
        <%= label_tag :championship_id, "Campeonato" %>
        <%= select_tag :championship_id, options_from_collection_for_select(@championships, :id, :to_s, @championship&.id),
                       class: form_control_classes %>
        <button type="submit" class="min-h-12 cursor-pointer rounded-sm border border-ink px-4 py-2 hover:bg-ink hover:text-white">Ver</button>
      <% end %>
    <% end %>
  </header>

  <nav class="flex gap-2" aria-label="Rankings" role="tablist">
    <% Cartola::RankingsController::TABS.each do |tab, label| %>
      <%= link_to label, main_app.esquadrao_rankings_path(tab:, championship_id: @championship&.id), role: "tab",
                  aria: { selected: tab == @tab, current: (tab == @tab ? "page" : nil) },
                  class: "rounded-sm border px-3 py-2 font-semibold #{tab == @tab ? 'border-cartola bg-cartola text-ink' : 'border-rule hover:bg-paper'}" %>
    <% end %>
  </nav>

  <%= render Cartola::RankingTableComponent.new(rows: @rows, kind: @tab, state: @championship ? :default : :empty) %>
</div>
