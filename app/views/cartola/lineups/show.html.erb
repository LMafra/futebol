<% content_for(:title, "Escalação · Rodada #{@lineup.round} · Futebol") %>

<div class="flex max-w-4xl flex-col gap-6">
  <header class="flex flex-wrap items-end justify-between gap-4 border-b-4 border-ink pb-2">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-graphite">Cartola · <%= @lineup.squad.name %></p>
      <h1 class="mt-1 font-display text-4xl font-extrabold tracking-tight">Rodada <span class="tabular-nums"><%= @lineup.round %></span></h1>
    </div>
    <nav class="flex items-center gap-4 text-sm font-semibold" aria-label="Rodadas">
      <% if @lineup.round > 1 %>
        <%= link_to "← Rodada #{@lineup.round - 1}", main_app.lineup_path(round: @lineup.round - 1, squad_id: params[:squad_id]), class: "text-pitch underline underline-offset-2 hover:no-underline" %>
      <% end %>
      <% if @lineup.round < 38 %>
        <%= link_to "Rodada #{@lineup.round + 1} →", main_app.lineup_path(round: @lineup.round + 1, squad_id: params[:squad_id]), class: "text-pitch underline underline-offset-2 hover:no-underline" %>
      <% end %>
    </nav>
  </header>

  <div><%= render "shared/flash" %></div>

  <%= render Cartola::BudgetBarComponent.new(spent: @lineup.total_cost) %>
  <%= render Cartola::PitchComponent.new(lineup: @lineup, state: @lineup.persisted? ? :default : :empty) %>

  <% if policy(@lineup).update? %>
    <%= link_to(@lineup.persisted? ? "Editar escalação" : "Escalar time", main_app.edit_lineup_path(round: @lineup.round),
                class: "self-start rounded-sm bg-cartola px-4 py-2 font-semibold text-ink hover:bg-ink hover:text-white") %>
  <% end %>
</div>
