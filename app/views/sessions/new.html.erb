<div class="mx-auto w-full max-w-md">
  <%= render "shared/flash" %>

  <p class="text-xs font-bold uppercase tracking-widest text-graphite"><%= brand(:name) %><%= " · #{@area[:title]}" if @area %></p>
  <h1 class="mt-1 border-b-4 border-ink pb-2 font-display text-4xl font-extrabold tracking-tight">Entrar</h1>

  <%= form_with url: session_url, class: "mt-6 flex flex-col gap-4" do |form| %>
    <%= hidden_field_tag :area, @area_key if @area_key.present? %>

    <div>
      <%= form.label :email_address, "E-mail", class: "text-sm font-semibold" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "voce@exemplo.com", value: params[:email_address], class: form_control_classes("mt-1 block w-full") %>
    </div>

    <div>
      <%= form.label :password, "Senha", class: "text-sm font-semibold" %>
      <%= password_reveal do %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: form_control_classes("block w-full", PasswordRevealHelper::PASSWORD_INPUT_PADDING) %>
      <% end %>
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <%= form.submit "Entrar", class: primary_button_classes %>
      <%= link_to "Esqueceu a senha?", new_password_path, class: support_link_classes("text-sm") %>
    </div>
  <% end %>

  <% unless @area %>
    <p class="mt-6 text-sm text-graphite">
      Ainda não tem conta? <%= link_to "Criar conta", signup_path, class: inline_link_classes(tone: :ink) %>
    </p>
  <% end %>
</div>
