<% if flash[:alert] %>
  <p class="mb-4 <%= error_classes("block") %> font-semibold" id="alert" role="alert"><%= flash[:alert] %></p>
<% end %>

<% if flash[:notice] %>
  <p class="mb-4 rounded-md border-l-4 border-pitch bg-win p-4 font-semibold text-ink" id="notice" role="status"><%= flash[:notice] %></p>
<% end %>
