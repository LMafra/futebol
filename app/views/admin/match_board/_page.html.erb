<%# Tela única da partida (Admin e Gestor): placar, lances por time, linha do tempo, legenda e Finalizar. %>
<% match = board.match %>
<% can_score = authorized?(:record_event, match) && !match.scored? && (!match.scheduled? || match.may_start_match?) %>
<% can_finalize = authorized?(:finalize, match) && (match.live? || match.may_start_match?) %>
<div class="flex flex-col gap-6 <%= 'pb-24' if can_finalize %>" data-role="match-board">
  <%= render "admin/match_board/scoreboard", match: %>

  <% if can_score %>
    <% if board.rule_missing? %>
      <p class="text-sm font-body font-semibold text-ink" role="status">Cadastre a regra "<%= Cartola::ScoringRule::DEFAULT_NAME %>" do Esquadrão para calcular os pontos.</p>
    <% end %>
    <%= render "admin/match_board/sides", board: %>
    <%= render "admin/match_board/lance_modal", board: %>
  <% elsif match.scored? %>
    <p class="<%= AdminHelper::ADMIN_MUTED_TEXT_CLASSES %>" role="status" data-role="readonly">Partida pontuada: os lances ficam só para leitura. Reverta a pontuação para alterá-los.</p>
  <% elsif match.scheduled? %>
    <p class="<%= AdminHelper::ADMIN_MUTED_TEXT_CLASSES %>" role="status">Os lances abrem no horário da partida, <%= match.match_date&.strftime("%d/%m às %H:%M") %>.</p>
  <% end %>

  <%= render "admin/match_board/timeline", board: %>

  <details class="rounded-md border border-rule bg-white px-4 py-2" data-role="legend">
    <summary class="min-h-10 cursor-pointer py-2 text-sm font-body font-semibold text-ink">Legenda</summary>
    <%= scout_legend %>
    <p class="<%= AdminHelper::ADMIN_MUTED_TEXT_CLASSES %> mb-2">"Jogou" e "Destaque" valem pontos sem lance. SG é calculado pelo placar.</p>
  </details>

  <% if can_finalize %>
    <%= render "admin/match_board/finalize", board: %>
  <% end %>
</div>
