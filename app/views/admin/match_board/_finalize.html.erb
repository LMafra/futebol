<%# Rodapé fixo com "Finalizar partida": o placar vem dos lances; confirmar no diálogo encerra e pontua. %>
<% match = board.match %>
<% form = MatchFinalizationForm.new(match:) %>
<div class="sticky bottom-[calc(3.5rem+env(safe-area-inset-bottom))] z-10 sm:bottom-0 flex flex-wrap items-center justify-between gap-3 border-t border-rule bg-white px-4 py-3" data-role="finalize-bar">
  <% if form.scouts? %>
    <p class="font-body text-ink" data-role="derived-score">
      Placar dos lances: <strong class="tabular-nums"><%= form.home_score %> × <%= form.away_score %></strong>
    </p>
    <%= modal_trigger "Finalizar partida", :finalize, "?modal=finalize" %>
  <% else %>
    <p class="text-sm font-body text-ink" data-role="no-scouts" role="status"><strong><%= MatchFinalizationForm::NO_SCOUTS %>.</strong></p>
  <% end %>
</div>

<% if form.scouts? %>
  <%= modal_form :finalize, title: "Finalizar partida", submit: "Finalizar e pontuar", record: form,
                 url: public_send(:"finalize_#{active_admin_namespace.name}_match_path", match) do |f| %>
    <p class="text-2xl font-bold tabular-nums text-ink" data-role="finalize-score">
      <%= match.home_team.name %> <%= form.home_score %> × <%= form.away_score %> <%= match.away_team.name %>
    </p>
    <p class="<%= AdminHelper::ADMIN_MUTED_TEXT_CLASSES %>">
      O placar vem dos lances. Ao confirmar, a partida é encerrada e os pontos do Bolão e do <%= module_label(:fantasy) %> são calculados na hora.
      <% if active_admin_namespace.name == :admin %>
        <%= link_to "Simular na Prévia do Bolão", admin_bolaopreview_path(match_id: match.id, candidate_home: form.home_score, candidate_away: form.away_score), class: inline_link_classes(tone: :ink) %>
      <% end %>
    </p>
  <% end %>
<% end %>
