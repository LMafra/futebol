<% overdue = manager_queue.count(&:overdue?) %>
<section class="mb-6 rounded-md border border-rule bg-white" aria-labelledby="pending-managers-title" data-role="admin-pending-managers">
  <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-rule px-4 py-3">
    <h3 class="font-display text-xl text-ink" id="pending-managers-title">Pedidos de gestor</h3>
    <p class="text-sm font-body text-ink" data-role="pending-managers-count">
      <span class="font-semibold tabular-nums"><%= manager_queue.size %></span> <%= manager_queue.one? ? "pendente" : "pendentes" %> ·
      <span class="font-semibold tabular-nums"><%= overdue %></span> há mais de 24h
    </p>
  </div>
  <div class="px-4 py-3">
    <%= render Ui::CollectionComponent.new(items: manager_queue, id: "pending-managers", mode: :table, item_id: ->(entry) { entry.user.id },
                                           texts: { label: "Pedidos de gestor" }) do |c| %>
      <% c.column(:name, label: "Nome", primary: true) { |entry| link_to entry.user.name, admin_user_path(entry.user), class: inline_link_classes(tone: :ink) } %>
      <% c.column(:email, label: "E-mail") { |entry| tag.span(entry.user.email_address, class: "[overflow-wrap:anywhere]") } %>
      <% c.column(:requested_at, label: "Pedido em", numeric: true) do |entry| %>
        <span class="whitespace-nowrap"><%= l(entry.requested_at, format: "%d/%m %H:%M") %></span>
        <% if entry.overdue? %><span class="ms-1 rounded-sm bg-loss px-1.5 py-0.5 text-xs font-semibold text-ink" data-role="overdue">+24h</span><% end %>
      <% end %>
      <% c.column(:actions, label: "Ações") do |entry| %>
        <% user = entry.user %>
        <div class="flex flex-wrap items-start gap-2">
          <%= button_to "Aprovar", approve_manager_admin_user_path(user), method: :put,
                        params: { return_to: "dashboard" }, class: AdminHelper::ADMIN_BUTTON_CLASSES,
                        form: { data: { role: "approve-manager-form" } },
                        aria: { label: "Aprovar #{user.name} como gestor" } %>
          <details class="group/reject" <%= "open" if flash[:manager_reject_error].to_s == user.id.to_s %>>
            <summary class="<%= AdminHelper::ADMIN_SECONDARY_BUTTON_CLASSES %> list-none" aria-label="Recusar pedido de <%= user.name %>">Recusar</summary>
            <div class="mt-2 w-72 max-w-full">
              <%= render "admin/users/reject_manager_form", user:, return_to: "dashboard" %>
            </div>
          </details>
        </div>
      <% end %>
      <% c.empty do %>
        <%= render Ui::EmptyStateComponent.new(title: "Nenhum pedido de gestor pendente.", description: "Novos pedidos aparecem aqui assim que chegam.") %>
      <% end %>
    <% end %>
  </div>
</section>
