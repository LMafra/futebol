<% metrics = [
     { label: "Campeonatos ativos", value: metrics_counts[:active_championships], href: admin_championships_path, accent: "border-l-pitch" },
     { label: "Partidas ao vivo", value: metrics_counts[:live_matches], href: admin_matches_path(q: { status_eq: "live" }), accent: "border-l-cartola" },
     { label: "Pendentes de finalização", value: metrics_counts[:pending_finalization], href: admin_matchfinalizer_path, accent: "border-l-ink" },
     { label: "Gestores pendentes", value: metrics_counts[:pending_managers], href: admin_users_path(scope: "pending"), accent: "border-l-graphite" }
   ]
   quick_actions = [
     { label: "Criar campeonato", href: new_admin_championship_path },
     { label: "Aprovar gestor", href: admin_users_path(scope: "pending") },
     { label: "Importar CSV", href: admin_csv_imports_path },
     { label: "Finalizar partida", href: admin_matchfinalizer_path }
   ] %>

<div class="mb-6 grid gap-4 lg:grid-cols-12" data-role="admin-metrics">
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:col-span-8 lg:grid-cols-4">
    <% metrics.each do |metric| %>
      <%= link_to metric[:href], class: "block rounded-md border border-rule border-l-[3px] #{metric[:accent]} bg-white px-4 py-3 no-underline text-ink hover:bg-paper focus:outline-hidden focus-visible:ring-2 focus-visible:ring-ink", data: { role: "admin-kpi", label: metric[:label] } do %>
        <div class="flex items-center justify-between gap-2">
          <p class="text-xs font-body font-bold uppercase tracking-widest text-graphite"><%= metric[:label] %></p>
          <%= admin_kpi_icon(metric[:label]) %>
        </div>
        <p class="mt-1 font-numeric text-3xl font-bold tabular-nums text-ink"><%= metric[:value] %></p>
      <% end %>
    <% end %>
  </div>
  <section class="rounded-md border border-rule bg-white px-4 py-3 lg:col-span-4" aria-labelledby="quick-actions-title" data-role="admin-quick-actions">
    <h3 class="text-xs font-body font-bold uppercase tracking-widest text-graphite" id="quick-actions-title">Ações rápidas</h3>
    <div class="mt-3 grid grid-cols-2 gap-2">
      <% quick_actions.each do |action| %>
        <%= link_to action[:label], action[:href], class: "inline-flex items-center justify-center rounded-md border border-rule bg-white px-3 py-2 text-center text-sm font-body font-semibold text-ink no-underline hover:border-ink" %>
      <% end %>
    </div>
  </section>
</div>

<%= render "admin/dashboard/pending_managers", manager_queue: manager_queue %>

<div class="grid gap-6 lg:grid-cols-12">
  <div class="flex flex-col gap-6 lg:col-span-8">
    <section class="rounded-md border border-rule bg-white" aria-labelledby="live-title">
      <h3 class="border-b border-rule px-4 py-3 font-display text-xl text-ink" id="live-title">Ao vivo: aguardando placar final (<%= live.size %>)</h3>
      <div class="px-4 py-3">
        <% if live.empty? %>
          <p class="font-body text-graphite">Nenhuma partida ao vivo.</p>
        <% else %>
          <%= render Ui::AdminTableComponent.new(
                headers: ["Partida", { label: "Início", numeric: true }, { label: "Placar", numeric: true }, ""],
                rows: live.map { |match|
                  [
                    link_to(match, admin_match_path(match), class: "font-semibold text-ink no-underline hover:underline"),
                    l(match.match_date, format: "%d/%m %H:%M"),
                    admin_score(match),
                    safe_join([
                      link_to("Preview", admin_bolaopreview_path(match_id: match.id), class: "font-semibold underline underline-offset-2"),
                      " · ".html_safe,
                      link_to("Finalizar", admin_matchfinalizer_path(match_id: match.id), class: "font-semibold underline underline-offset-2")
                    ])
                  ]
                },
                texts: { label: "Partidas ao vivo", empty: "Nenhuma partida ao vivo." }
              ) %>
        <% end %>
      </div>
    </section>

    <section class="rounded-md border border-rule bg-white" aria-labelledby="recent-matches-title" data-role="admin-recent-matches">
      <h3 class="border-b border-rule px-4 py-3 font-display text-xl text-ink" id="recent-matches-title">Últimas partidas</h3>
      <div class="px-4 py-3">
        <%= render Ui::AdminTableComponent.new(
              headers: ["Partida", { label: "Início", numeric: true }, "Status", { label: "Placar", numeric: true }],
              rows: recent_matches.map { |match|
                [
                  link_to(match, admin_match_path(match), class: "font-semibold text-ink no-underline hover:underline"),
                  l(match.match_date, format: "%d/%m %H:%M"),
                  admin_match_status_badge(match),
                  admin_score(match)
                ]
              },
              texts: { label: "Últimas partidas", empty: "Nenhuma partida cadastrada." }
            ) %>
      </div>
    </section>

    <section class="rounded-md border border-rule bg-white" aria-labelledby="pending-title">
      <h3 class="border-b border-rule px-4 py-3 font-display text-xl text-ink" id="pending-title">Encerradas com pontuação pendente (<%= pending.size %>)</h3>
      <div class="px-4 py-3">
        <% if pending.empty? %>
          <p class="font-body text-graphite">Nada pendente: toda partida encerrada já foi pontuada.</p>
        <% else %>
          <ul class="flex flex-col gap-1 font-body">
            <% pending.each do |match| %>
              <li><%= link_to match, admin_match_path(match), class: "font-semibold text-ink no-underline hover:underline" %> · <span class="tabular-nums"><%= admin_score(match) %></span></li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </section>
  </div>

  <section class="rounded-md border border-rule bg-white lg:col-span-4" aria-labelledby="log-title">
    <h3 class="border-b border-rule px-4 py-3 font-display text-xl text-ink" id="log-title">Últimas ações</h3>
    <div class="px-4 py-3">
      <%= render Ui::AdminTableComponent.new(
            headers: ["Ação", "Quem"],
            rows: recent_logs.map { |log|
              [
                safe_join([tag.span(log.action, class: "status-tag"), " ".html_safe, admin_auditable_link(log)]),
                "#{log.user || 'sistema'} · #{l(log.created_at, format: '%d/%m %H:%M')}"
              ]
            },
            texts: { label: "Últimas ações", empty: "Nenhum registro ainda." },
            table_role: "recent-audit-logs"
          ) %>
      <%= link_to "Ver histórico completo", admin_audithistory_path, class: "mt-4 inline-block font-body font-semibold text-ink underline underline-offset-2 hover:no-underline" %>
    </div>
  </section>
</div>
