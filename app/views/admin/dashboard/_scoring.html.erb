<% urgency = local_assigns[:urgency] %>
<% action_groups = local_assigns.fetch(:action_groups) %>

<div class="mb-2" data-role="admin-dashboard-hero">
  <p class="font-body text-sm text-graphite">Console operacional — o que precisa de atenção agora.</p>
</div>

<div class="mb-6" data-role="admin-metrics">
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <%= render Ui::KpiCardComponent.new(
          value: metrics_counts[:active_championships],
          label: "Campeonatos ativos",
          action_text: "Ver campeonatos",
          action_path: admin_championships_path,
          data_role: "admin-kpi"
        ) %>
    <%= render Ui::KpiCardComponent.new(
          value: metrics_counts[:live_matches],
          label: "Partidas ao vivo",
          action_text: "Filtrar central",
          action_path: admin_root_path(urgency: "critical"),
          status: metrics_counts[:live_matches].zero? ? :zero : :alert,
          data_role: "admin-kpi"
        ) %>
    <%= render Ui::KpiCardComponent.new(
          value: metrics_counts[:pending_scoring],
          label: "Pontuação pendente",
          action_text: "Filtrar central",
          action_path: admin_root_path(urgency: "high"),
          status: metrics_counts[:pending_scoring].zero? ? :zero : :alert,
          data_role: "admin-kpi"
        ) %>
    <%= render Ui::KpiCardComponent.new(
          value: metrics_counts[:pending_managers],
          label: "Gestores pendentes",
          action_text: "Filtrar central",
          action_path: admin_root_path(urgency: "medium"),
          status: metrics_counts[:pending_managers].zero? ? :zero : :normal,
          data_role: "admin-kpi"
        ) %>
  </div>
</div>

<%= render Ui::ActionCenterComponent.new(groups: action_groups, filter_urgency: urgency, title: "Central de ações") %>

<%= render "admin/dashboard/pending_managers", manager_queue: manager_queue %>

<div class="grid gap-6 lg:grid-cols-12">
  <div class="flex min-w-0 flex-col gap-6 lg:col-span-8">
    <section class="rounded-md border border-rule bg-white" aria-labelledby="live-title">
      <h3 class="border-b border-rule px-4 py-3 font-display text-xl text-ink" id="live-title">Ao vivo: aguardando placar final (<%= live.size %>)</h3>
      <div class="px-4 py-3">
        <%= render Ui::CollectionComponent.new(items: live, id: "live-matches", mode: :table, texts: { label: "Partidas ao vivo", empty: "Nenhuma partida ao vivo." }) do |c| %>
          <% c.column(:match, label: "Partida", primary: true) { |match| link_to match, admin_match_path(match), class: inline_link_classes(tone: :ink) } %>
          <% c.column(:match_date, label: "Início", numeric: true) { |match| l(match.match_date, format: "%d/%m %H:%M") } %>
          <% c.column(:score, label: "Placar", numeric: true) { |match| admin_score(match) } %>
          <% c.column(:actions, label: "Ações") do |match| %>
            <%= link_to "Prévia do Bolão", admin_bolaopreview_path(match_id: match.id), class: inline_link_classes(tone: :ink) %> ·
            <%= link_to "Finalizar", admin_match_path(match, modal: "finalize"), class: inline_link_classes(tone: :ink) %>
          <% end %>
        <% end %>
      </div>
    </section>

    <section class="rounded-md border border-rule bg-white" aria-labelledby="recent-matches-title" data-role="admin-recent-matches">
      <h3 class="border-b border-rule px-4 py-3 font-display text-xl text-ink" id="recent-matches-title">Últimas partidas</h3>
      <div class="px-4 py-3">
        <%= render Ui::CollectionComponent.new(items: recent_matches, id: "recent-matches", mode: :table, texts: { label: "Últimas partidas", empty: "Nenhuma partida cadastrada." }) do |c| %>
          <% c.column(:match, label: "Partida", primary: true) { |match| link_to match, admin_match_path(match), class: inline_link_classes(tone: :ink) } %>
          <% c.column(:match_date, label: "Início", numeric: true) { |match| l(match.match_date, format: "%d/%m %H:%M") } %>
          <% c.column(:status, label: "Situação") { |match| admin_match_status_badge(match) } %>
          <% c.column(:score, label: "Placar", numeric: true) { |match| admin_score(match) } %>
        <% end %>
      </div>
    </section>

    <section class="rounded-md border border-rule bg-white" aria-labelledby="pending-title">
      <h3 class="border-b border-rule px-4 py-3 font-display text-xl text-ink" id="pending-title">Encerradas com pontuação pendente (<%= pending.size %>)</h3>
      <div class="px-4 py-3">
        <%= render Ui::CollectionComponent.new(items: pending, id: "pending-scoring", mode: :table, texts: { label: "Encerradas com pontuação pendente", empty: "Nada pendente: toda partida encerrada já foi pontuada." }) do |c| %>
          <% c.column(:match, label: "Partida", primary: true) { |match| link_to match, admin_match_path(match), class: inline_link_classes(tone: :ink) } %>
          <% c.column(:status, label: "Situação") { |match| admin_match_status_badge(match) } %>
          <% c.column(:score, label: "Placar", numeric: true) { |match| admin_score(match) } %>
          <% c.column(:actions, label: "Ações") { |match| link_to "Finalizar", admin_match_path(match, modal: "finalize"), class: inline_link_classes(tone: :ink) } %>
        <% end %>
      </div>
    </section>
  </div>

  <section class="min-w-0 rounded-md border border-rule bg-white lg:col-span-4" aria-labelledby="log-title">
    <h3 class="border-b border-rule px-4 py-3 font-display text-xl text-ink" id="log-title">Últimas ações</h3>
    <div class="px-4 py-3">
      <%= render Ui::AdminTableComponent.new(
            headers: ["Ação", "Quem"],
            rows: recent_logs.map { |log|
              [
                safe_join([tag.span(log.action, class: "status-tag"), " ".html_safe, admin_auditable_link(log)]),
                "#{log.user || 'sistema'} · #{l(log.created_at, format: '%d/%m %H:%M')}"
              ]
            },
            texts: { label: "Últimas ações", empty: "Nenhum registro ainda." },
            table_role: "recent-audit-logs"
          ) %>
      <%= link_to "Ver histórico completo", admin_audithistory_path, class: inline_link_classes("mt-4 inline-block font-body", tone: :ink) %>
    </div>
  </section>
</div>
