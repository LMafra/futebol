<%= render "admin/shared/match_picker", url: admin_matchreversal_path, matches: matches, match: match %>

<% if match %>
  <section class="panel" aria-labelledby="revert-title">
    <h3 class="panel-title" id="revert-title">Reverter pontos · <%= match %> (<%= admin_score(match) %>)</h3>
    <div class="panel-body">
      <p class="mb-4 text-sm text-gray-600 dark:text-gray-400">
        Descarta (soft delete) os pontos calculados para esta partida e registra a reversão no histórico de auditoria,
        com o seu usuário, o IP e o motivo. A partida pode ser pontuada de novo depois.
      </p>

      <%= render "admin/shared/errors", form: form %>

      <%= form_with model: form, url: admin_matchreversal_revert_path, method: :post, class: "flex flex-col gap-4", data: { turbo: false } do |f| %>
        <%= hidden_field_tag "reversal[match_id]", match.id %>
        <div class="max-w-2xl">
          <%= f.label :reason, "Motivo da reversão (obrigatório)", class: AdminHelper::ADMIN_LABEL_CLASSES %>
          <%= f.text_area :reason, rows: 3, maxlength: 500, required: true, class: AdminHelper::ADMIN_INPUT_CLASSES %>
        </div>
        <div>
          <%= f.submit "Reverter pontuação", class: AdminHelper::ADMIN_DANGER_BUTTON_CLASSES %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
