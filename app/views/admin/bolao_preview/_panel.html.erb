<%= render "admin/shared/match_picker", url: admin_bolaopreview_path, matches: matches, match: match %>

<% if match %>
  <section class="panel" aria-labelledby="candidate-title">
    <h3 class="panel-title" id="candidate-title">Placar candidato · <%= match %></h3>
    <div class="panel-body">
      <p class="mb-4 <%= AdminHelper::ADMIN_MUTED_TEXT_CLASSES %>">
        Simula a pontuação dos palpites com um placar hipotético. Nada é gravado; o placar real (<%= admin_score(match) %>) não é usado.
      </p>
      <%= form_with url: admin_bolaopreview_path, method: :get, class: "flex flex-wrap items-end gap-3", data: { turbo: false } do %>
        <%= hidden_field_tag :match_id, match.id %>
        <div class="w-32">
          <%= label_tag :candidate_home, admin_required_label(match.home_team.name), class: AdminHelper::ADMIN_LABEL_CLASSES %>
          <%= number_field_tag :candidate_home, candidate_home, min: 0, step: 1, required: true, class: AdminHelper::ADMIN_INPUT_CLASSES %>
        </div>
        <span class="pb-2 text-lg font-bold" aria-hidden="true">×</span>
        <div class="w-32">
          <%= label_tag :candidate_away, admin_required_label(match.away_team.name), class: AdminHelper::ADMIN_LABEL_CLASSES %>
          <%= number_field_tag :candidate_away, candidate_away, min: 0, step: 1, required: true, class: AdminHelper::ADMIN_INPUT_CLASSES %>
        </div>
        <%= submit_tag "Calcular preview", name: nil, class: AdminHelper::ADMIN_BUTTON_CLASSES %>
      <% end %>

      <% if preview_error %>
        <p class="mt-4 <%= AdminHelper::ADMIN_ALERT_CLASSES %>" role="alert"><%= preview_error %></p>
      <% end %>
    </div>
  </section>

  <% if preview %>
    <section class="panel" aria-labelledby="preview-title" data-role="preview">
      <h3 class="panel-title" id="preview-title">
        Pontuação simulada para <span class="tabular-nums" data-role="candidate-score"><%= candidate_home %> × <%= candidate_away %></span>
      </h3>
      <div class="panel-body">
        <% if preview.rows.empty? %>
          <%= render Ui::EmptyStateComponent.new(title: "Nenhum palpite para esta partida",
                                                 description: "Quando houver palpites, a pontuação simulada aparece aqui.") %>
        <% else %>
          <table class="data-table">
            <thead>
              <tr><th>Bolão</th><th>Participante</th><th>Palpite</th><th class="text-right">Pontos</th></tr>
            </thead>
            <tbody>
              <% preview.rows.each do |row| %>
                <tr>
                  <td><%= pools[row.pool_id] %></td>
                  <td><%= users[row.user_id] %></td>
                  <td class="tabular-nums"><%= row.home_guess %> × <%= row.away_guess %></td>
                  <td class="text-right font-semibold tabular-nums" data-role="points"><%= row.points %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr><th colspan="3">Total distribuído</th><th class="text-right tabular-nums" data-role="total"><%= preview.total %></th></tr>
            </tfoot>
          </table>
        <% end %>

        <div class="mt-4 flex flex-wrap items-center gap-3">
          <% if match.live? || match.may_start_match? %>
            <%= link_to "Ir para a finalização", admin_match_path(match, modal: "finalize"),
                        class: AdminHelper::ADMIN_BUTTON_CLASSES, data: { role: "confirm-score" } %>
            <span class="<%= AdminHelper::ADMIN_MUTED_TEXT_CLASSES %>">Na finalização vale o placar dos lances, não o placar simulado.</span>
          <% else %>
            <span class="<%= AdminHelper::ADMIN_MUTED_TEXT_CLASSES %>">A partida está <%= admin_match_status_label(match.status).downcase %>; só partidas ao vivo podem ser finalizadas.</span>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>
<% end %>
