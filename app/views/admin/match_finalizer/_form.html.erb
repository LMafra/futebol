<%= render "admin/shared/match_picker", url: admin_matchfinalizer_path, matches: matches, match: match %>

<% if match %>
  <section class="panel" aria-labelledby="finalize-title">
    <h3 class="panel-title" id="finalize-title">Placar final · <%= match %></h3>
    <div class="panel-body">
      <p class="mb-4 text-sm text-gray-600 dark:text-gray-400">
        Encerra a partida e enfileira o cálculo dos pontos. Para confirmar, digite o placar novamente no formato <strong>2x1</strong>.
        <%= link_to "Simular antes no Preview do Bolão", admin_bolaopreview_path(match_id: match.id, candidate_home: form.home_score, candidate_away: form.away_score), class: "font-semibold underline underline-offset-2" %>
      </p>

      <%= render "admin/shared/errors", form: form %>

      <%= form_with model: form, url: admin_matchfinalizer_finalize_path, method: :post, class: "flex flex-col gap-4", data: { turbo: false } do |f| %>
        <%= hidden_field_tag "finalization[match_id]", match.id %>
        <div class="flex flex-wrap items-end gap-3">
          <div class="w-32">
            <%= f.label :home_score, match.home_team.name, class: AdminHelper::ADMIN_LABEL_CLASSES %>
            <%= f.number_field :home_score, min: 0, max: 99, step: 1, required: true, class: AdminHelper::ADMIN_INPUT_CLASSES %>
          </div>
          <span class="pb-2 text-lg font-bold" aria-hidden="true">×</span>
          <div class="w-32">
            <%= f.label :away_score, match.away_team.name, class: AdminHelper::ADMIN_LABEL_CLASSES %>
            <%= f.number_field :away_score, min: 0, max: 99, step: 1, required: true, class: AdminHelper::ADMIN_INPUT_CLASSES %>
          </div>
        </div>
        <div class="w-64">
          <%= f.label :score_confirmation, "Confirme o placar (ex.: 2x1)", class: AdminHelper::ADMIN_LABEL_CLASSES %>
          <%= f.text_field :score_confirmation, required: true, autocomplete: "off", class: AdminHelper::ADMIN_INPUT_CLASSES %>
        </div>
        <div>
          <%= f.submit "Finalizar partida", class: AdminHelper::ADMIN_BUTTON_CLASSES %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
