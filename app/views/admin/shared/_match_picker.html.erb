<%# Selects the match a page works on (GET, reloads the page with ?match_id=). %>
<%= form_with url: url, method: :get, class: "mb-6 flex flex-wrap items-end gap-3", data: { turbo: false } do %>
  <div class="min-w-80 grow">
    <%= label_tag :match_id, "Partida", class: AdminHelper::ADMIN_LABEL_CLASSES %>
    <%= select_tag :match_id,
                   options_for_select(matches.map { |m| [admin_match_option(m), m.id] }, match&.id),
                   include_blank: matches.any? ? "Selecione…" : "Nenhuma partida elegível",
                   class: AdminHelper::ADMIN_INPUT_CLASSES %>
  </div>
  <%= submit_tag "Abrir", name: nil, class: AdminHelper::ADMIN_BUTTON_CLASSES %>
<% end %>
