<% if form.errors.any? %>
  <div class="mb-4 rounded-md border-l-4 border-red-700 bg-red-50 px-4 py-3 text-sm text-red-900 dark:bg-red-950 dark:text-red-100" role="alert" data-role="form-errors">
    <p class="font-semibold">Corrija os campos abaixo:</p>
    <ul class="mt-1 list-disc ps-5">
      <% form.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
