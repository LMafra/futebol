<% if form.errors.any? %>
  <div class="mb-4 <%= AdminHelper::ADMIN_ALERT_CLASSES %>" role="alert" data-role="form-errors">
    <p class="font-semibold">Corrija os campos abaixo:</p>
    <ul class="mt-1 list-disc ps-5">
      <% form.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
