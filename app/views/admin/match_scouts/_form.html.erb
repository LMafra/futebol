<%= render "admin/shared/match_picker", url: admin_matchscouts_path, matches: matches, match: match %>

<% if match %>
  <% sides = { "home" => ["Mandante", match.home_team], "away" => ["Visitante", match.away_team] } %>
  <% scouts = { goals: "G", assists: "A", penalty_saves: "DP", saves: "DE", yellow_cards: "CA", red_cards: "CV", own_goals: "GC" } %>
  <section class="panel" aria-labelledby="scouts-title" data-controller="scouts"
           data-scouts-weights-value="<%= sheet.preview_weights.to_json %>">
    <h3 class="panel-title" id="scouts-title">Scouts · <%= match %> · <%= admin_score(match) %></h3>
    <div class="panel-body">
      <% if errors.any? %>
        <div class="mb-4 rounded-md border-l-4 border-red-700 bg-red-50 px-4 py-3 text-sm text-red-900 dark:bg-red-950 dark:text-red-100" role="alert" data-role="form-errors">
          <p class="font-semibold">Os scouts não foram salvos:</p>
          <ul class="mt-1 list-disc ps-5">
            <% errors.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if sheet.readonly? %>
        <p class="mb-4 text-sm font-semibold" data-role="readonly" role="status">Partida pontuada: os scouts ficam só para leitura. Reverta a pontuação para alterá-los.</p>
      <% elsif sheet.rule.nil? %>
        <p class="mb-4 text-sm font-semibold" role="status">Cadastre a regra "<%= Cartola::ScoringRule::DEFAULT_NAME %>" do Esquadrão para calcular os pontos.</p>
      <% end %>

      <div class="mb-4 flex gap-2" role="tablist" aria-label="Times">
        <% sides.each_with_index do |(side, (label, team)), index| %>
          <button type="button" role="tab" class="<%= AdminHelper::ADMIN_BUTTON_CLASSES %>" aria-selected="<%= index.zero? %>"
                  data-scouts-target="tab" data-side="<%= side %>" data-action="scouts#show" data-scouts-side-param="<%= side %>">
            <%= label %> · <%= team.name %>
          </button>
        <% end %>
      </div>

      <%= form_with url: admin_matchscouts_record_path, method: :post, data: { turbo: false, action: "input->scouts#refresh change->scouts#refresh" } do %>
        <%= hidden_field_tag :match_id, match.id %>
        <% sides.each_with_index do |(side, (label, team)), index| %>
          <% lines = sheet.lines_for(team) %>
          <div data-scouts-target="team" data-side="<%= side %>" data-role="team-<%= side %>" <%= "hidden" unless index.zero? %>>
            <label class="mb-2 inline-flex items-center gap-2 text-sm font-semibold">
              <input type="checkbox" data-action="scouts#toggleAll" <%= "disabled" if sheet.readonly? %>>
              Jogou: marcar todos do <%= label.downcase %>
            </label>
            <div class="overflow-x-auto">
              <table class="data-table" data-role="scouts-table">
                <thead>
                  <tr>
                    <th>Nome</th>
                    <% scouts.each_value do |abbr| %><th class="text-center"><%= abbr %></th><% end %>
                    <th class="text-center">SG</th><th class="text-center">Jogou</th><th class="text-center">Destaque</th><th class="text-right">Pts</th>
                  </tr>
                </thead>
                <tbody>
                  <% if lines.empty? %>
                    <tr><td colspan="<%= scouts.size + 5 %>">Nenhum jogador cadastrado em <%= team.name %>.</td></tr>
                  <% end %>
                  <% lines.each do |line| %>
                    <% name = "scouts[#{line.player.id}]" %>
                    <tr data-scouts-target="row" data-side="<%= side %>" data-player-id="<%= line.player.id %>">
                      <td class="whitespace-nowrap">
                        <%= line.player.name %> <span class="text-xs text-gray-500"><%= line.player.position %></span>
                        <%= hidden_field_tag "#{name}[team_id]", line.team_id, id: nil %>
                      </td>
                      <% scouts.each_key do |scout| %>
                        <% range = Cartola::PlayerScore::SCOUT_LIMITS.fetch(scout) %>
                        <% disabled = sheet.readonly? || (scout == :saves && !line.goalkeeper?) %>
                        <td>
                          <div class="flex items-center gap-1">
                            <button type="button" class="cursor-pointer px-1 font-bold" aria-label="menos" data-action="scouts#step" data-scouts-delta-param="-1" <%= "disabled" if disabled %>>−</button>
                            <%= number_field_tag "#{name}[#{scout}]", line.values[scout], id: nil, min: range.min, max: range.max, step: 1,
                                                 disabled:, class: "w-12 rounded-md border border-gray-300 px-1 py-1 text-center text-sm tabular-nums dark:border-gray-600 dark:bg-gray-800",
                                                 data: { scout: }, aria: { label: "#{scouts[scout]} de #{line.player.name}" } %>
                            <button type="button" class="cursor-pointer px-1 font-bold" aria-label="mais" data-action="scouts#step" data-scouts-delta-param="1" <%= "disabled" if disabled %>>+</button>
                          </div>
                        </td>
                      <% end %>
                      <td class="text-center" data-role="clean-sheet"><%= line.values[:clean_sheet] ? "SG" : "–" %></td>
                      <td class="text-center">
                        <%= hidden_field_tag "#{name}[played]", "0", id: nil %>
                        <%= check_box_tag "#{name}[played]", "1", line.values[:played], id: nil, disabled: sheet.readonly?,
                                          data: { scout: "played" }, aria: { label: "#{line.player.name} jogou" } %>
                      </td>
                      <td class="text-center">
                        <%= radio_button_tag :highlight, line.player.id, sheet.highlight_player_id == line.player.id, id: nil,
                                             disabled: sheet.readonly?, data: { scout: "highlight" }, aria: { label: "#{line.player.name} foi o destaque" } %>
                      </td>
                      <td class="text-right tabular-nums" data-role="points"><%= line.points ? format("%.2f", line.points) : "–" %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>

        <% unless sheet.readonly? %>
          <div class="mt-4 flex flex-wrap items-center gap-4">
            <label class="inline-flex items-center gap-2 text-sm">
              <%= radio_button_tag :highlight, "", sheet.highlight_player_id.nil?, id: nil %> Sem destaque
            </label>
            <%= submit_tag "Salvar scouts", name: nil, class: AdminHelper::ADMIN_BUTTON_CLASSES %>
            <%= link_to "Ir para a finalização", admin_matchfinalizer_path(match_id: match.id), class: "text-sm font-semibold underline underline-offset-2" if match.live? || match.may_start_match? %>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
