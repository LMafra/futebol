<%# Partidas (/admin e /gestor): por rodada de cada campeonato (a primeira com jogo por fazer aberta) ou agenda por dia. %>
<% views = { grouped: "Por rodada", table: "Lista", agenda: "Agenda" }
   view = listing_view(views)
   open_key = records.find { _1.status.in?(%w[scheduled live]) } || records.first
   grouping = case view
              when :agenda
                { group_by: ->(match) { match.match_date&.to_date },
                  group_label: ->(date) { date ? l(date, format: "%A, %d/%m/%Y").capitalize : "Sem data" } }
              when :grouped
                { group_by: ->(match) { [match.championship, match.round] },
                  open_group: open_key && [open_key.championship, open_key.round],
                  group_label: ->((championship, round)) { "#{championship.name} · #{round ? "Rodada #{round}" : 'Sem rodada'}" } }
              else
                {}
              end
   match_scope = Core::Match.where(id: records.map(&:id))
   steps = Gestor::MatchQueue.new(match_scope)
   scouted_ids = Cartola::PlayerScore.kept.where(match_id: match_scope.select(:id)).distinct.pluck(:match_id).to_set %>
<%= render "admin/listings/agenda_weeks" if view == :agenda %>
<%= render Ui::CollectionComponent.new(items: records, id: "matches", views:, view:, selectable: true, texts: { label: "Partidas" }, **grouping) do |c| %>
  <% c.bulk_fields do %>
    <fieldset class="flex w-full flex-wrap items-center gap-2 sm:w-auto">
      <legend class="sr-only">Reagendar</legend>
      <label class="flex items-center gap-2 text-sm font-semibold text-ink">Deslocar
        <%= number_field_tag :shift_amount, nil, min: -AdminBulkActions::MAX_SHIFT, max: AdminBulkActions::MAX_SHIFT, class: "min-h-12 w-20 #{AdminHelper::ADMIN_INPUT_CLASSES}" %>
      </label>
      <label class="text-sm font-semibold text-ink"><span class="sr-only">Unidade</span>
        <%= select_tag :shift_unit, options_for_select([%w[dias days], %w[horas hours]]), class: "min-h-12 w-auto #{AdminHelper::ADMIN_INPUT_CLASSES}" %>
      </label>
      <label class="flex w-full items-center gap-2 text-sm font-semibold text-ink sm:w-64">Motivo
        <%= text_field_tag :reason, nil, maxlength: 200, class: "min-h-12 w-full min-w-0 #{AdminHelper::ADMIN_INPUT_CLASSES}" %>
      </label>
    </fieldset>
  <% end %>
  <% c.bulk_action "Reagendar", url: public_send(:"bulk_reschedule_#{namespace}_matches_path") %>
  <% c.bulk_action "Excluir", url: public_send(:"bulk_destroy_#{namespace}_matches_path"), danger: true,
                   confirm: "Excluir as partidas selecionadas? Só as agendadas sem palpites nem lances são excluídas." %>
  <% c.column(:match_date, label: "Data/Hora", numeric: true) do |match|
       match.match_date && l(match.match_date, format: view == :agenda ? "%H:%M" : "%d/%m %H:%M")
     end %>
  <% c.column(:teams, label: "Confronto", primary: true) { |match| link_to match, public_send(:"#{namespace}_match_path", match), class: inline_link_classes(tone: :ink) } %>
  <% c.column(:status, label: "Situação") { |match| admin_match_status_badge(match, scouted_ids:) } %>
  <% c.column(:score, label: "Placar", numeric: true) { |match| admin_score(match) } %>
  <% c.column(:round, label: "Rodada", numeric: true) { |match| match.round || "—" } %>
  <% c.column(:action, label: "Ação") do |match| %>
    <% step = steps.step_for(match) %>
    <div class="flex flex-wrap items-center gap-2" data-role="match-row-actions">
      <%= match_contextual_action(match, step, namespace) %>
      <details class="relative inline-block text-left" data-role="match-row-kebab">
        <summary class="<%= AdminHelper::ADMIN_SECONDARY_BUTTON_CLASSES %> list-none min-h-11 min-w-11" aria-label="Mais ações: <%= match %>">⋯</summary>
        <ul class="absolute end-0 z-10 mt-1 min-w-44 rounded-md border border-rule bg-white p-2 shadow-md">
          <% if match.may_revert_match? && authorized?(:revert, match) %>
            <li><%= link_to "Reverter", scoring_path("matchreversal", match_id: match.id), class: "block min-h-11 px-2 py-2 text-ink", data: { role: "match-revert" } %></li>
          <% end %>
          <li><%= link_to "Exportar", public_send(:"#{namespace}_matches_path", format: :csv), class: "block min-h-11 px-2 py-2 text-ink" %></li>
          <% if match.scheduled? && authorized?(:destroy, match) %>
            <li><%= link_to "Excluir", public_send(:"#{namespace}_match_path", match), method: :delete, class: "block min-h-11 px-2 py-2 font-semibold text-ink", data: { turbo_method: :delete, turbo_confirm: "Excluir esta partida agendada?" } %></li>
          <% end %>
        </ul>
      </details>
    </div>
  <% end %>
<% end %>
