<%# Importações CSV (/admin): tabela; no celular, um cartão por importação. %>
<%= render Ui::CollectionComponent.new(items: records, id: "csv-imports", mode: :table, **listing_sort_options,
                                       texts: { label: "Importações CSV" }) do |c| %>
  <% c.column(:id, label: "Importação", primary: true, sortable: true) { |csv_import| link_to "Importação ##{csv_import.id}", admin_csv_import_path(csv_import), class: inline_link_classes(tone: :ink) } %>
  <% c.column(:status, label: "Situação") { |csv_import| admin_csv_import_status_label(csv_import.status) } %>
  <% c.column(:rows_processed, label: "Linhas", numeric: true) %>
  <% c.column(:error_message, label: "Erro") { |csv_import| csv_import.error_message.presence || "—" } %>
  <% c.column(:created_at, label: "Enviada em", numeric: true, sortable: true) { |csv_import| l(csv_import.created_at, format: "%d/%m/%Y %H:%M") } %>
<% end %>
