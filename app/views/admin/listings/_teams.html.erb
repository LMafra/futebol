<%# Times (/admin e /gestor): grade de escudos ou tabela. %>
<% players = listing_counts(Core::Player, :team_id, records)
   views = { grid: "Grade", table: "Tabela" } %>
<%= render Ui::CollectionComponent.new(items: records, id: "teams", views:, view: listing_view(views), **listing_sort_options,
                                       selectable: true, texts: { label: "Times" }) do |c| %>
  <% c.bulk_fields do %>
    <label class="flex flex-wrap items-center gap-2 text-sm font-semibold text-ink">
      Campeonato
      <%= select_tag :championship_id, options_for_select(bulk_championship_options), include_blank: "Escolha para inscrever ou remover", class: "min-h-12 w-auto #{AdminHelper::ADMIN_INPUT_CLASSES}" %>
    </label>
  <% end %>
  <% c.bulk_action "Inscrever no campeonato", url: public_send(:"bulk_enroll_#{namespace}_teams_path") %>
  <% c.bulk_action "Remover do campeonato", url: public_send(:"bulk_unenroll_#{namespace}_teams_path") %>
  <% c.bulk_action "Excluir", url: public_send(:"bulk_destroy_#{namespace}_teams_path"), danger: true,
                   confirm: "Excluir os times selecionados? Os que têm partidas ou jogadores são mantidos." %>
  <% c.column(:crest, label: "Escudo", media: true) { |team| team_crest(team, size: "size-12") } %>
  <% c.column(:name, label: "Time", primary: true, sortable: true) { |team| link_to team.name, public_send(:"#{namespace}_team_path", team), class: inline_link_classes(tone: :ink) } %>
  <% c.column(:players, label: "Jogadores", numeric: true) { |team| pluralize(players.fetch(team.id, 0), "jogador", plural: "jogadores") } %>
  <% c.column(:short_name, label: "Sigla", sortable: true) %>
  <% c.column(:captain_name, label: "Capitão") %>
  <% if namespace == :admin %>
    <% c.column(:manager, label: "Gestor") { |team| team.manager&.name || "Admin" } %>
  <% end %>
  <% c.column(:actions, label: "Ações") do |team| %>
    <% if authorized?(:update, team) %>
      <%= admin_icon_action_link("Editar", public_send(:"edit_#{namespace}_team_path", team), :edit, subject: team.name) %>
    <% end %>
  <% end %>
<% end %>
