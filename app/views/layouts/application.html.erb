<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "Futebol" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Futebol">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= render "layouts/fonts" %>
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-paper text-ink">
    <header class="bg-pitch text-white">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3">
        <%= link_to "Craquefy", main_app.root_path, class: "font-display text-2xl font-extrabold tracking-tight" %>
        <nav class="flex items-center gap-4 text-sm font-semibold" aria-label="Principal">
          <%= link_to "Simulador", main_app.simulador_path, class: "underline-offset-2 hover:underline" %>
          <% if user_signed_in? %>
            <details class="relative" data-role="account-menu">
              <summary class="cursor-pointer list-none underline-offset-2 hover:underline">Minha conta</summary>
              <ul class="absolute right-0 z-10 mt-2 flex w-48 flex-col rounded-sm border border-rule bg-white py-1 text-ink">
                <li><%= link_to "Minha conta", main_app.account_path, class: "block px-3 py-2 hover:bg-paper" %></li>
                <li><%= link_to "Meus bolões", main_app.pools_path, class: "block px-3 py-2 hover:bg-paper" %></li>
                <li><%= link_to "Meu #{module_label(:fantasy).downcase}", main_app.esquadrao_path, class: "block px-3 py-2 hover:bg-paper" %></li>
                <li><%= link_to "Rankings", main_app.esquadrao_rankings_path, class: "block px-3 py-2 hover:bg-paper" %></li>
              </ul>
            </details>
            <%= button_to "Sair", main_app.session_path, method: :delete, class: "cursor-pointer underline-offset-2 hover:underline" %>
          <% else %>
            <%= link_to "Entrar", main_app.login_path, class: "rounded-sm border border-white px-3 py-1 font-bold transition-colors duration-fast ease-editorial hover:bg-white hover:text-pitch" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-8">
      <%= yield %>
    </main>

    <footer class="border-t border-rule">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-6 text-sm text-graphite">
        <p>© <span class="tabular-nums"><%= Date.current.year %></span> Craquefy</p>
        <nav class="flex flex-wrap items-center gap-4" aria-label="Rodapé">
          <%= link_to "GitHub", "https://github.com/LMafra/futebol", class: "underline underline-offset-2 hover:no-underline", rel: "noopener" %>
          <%= link_to "Documentação", "https://github.com/LMafra/futebol/tree/main/docs", class: "underline underline-offset-2 hover:no-underline", rel: "noopener" %>
          <%= link_to "Licença MIT", "https://github.com/LMafra/futebol/blob/main/LICENSE", class: "underline underline-offset-2 hover:no-underline", rel: "noopener" %>
          <%= link_to "Acesso administrativo", "/admin", class: "underline underline-offset-2 hover:no-underline" %>
        </nav>
      </div>
    </footer>
  </body>
</html>
