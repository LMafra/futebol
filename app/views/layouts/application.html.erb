<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || brand(:name) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= brand(:name) %>">
    <meta name="description" content="<%= brand(:description) %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= render "layouts/fonts" %>
    <%= stylesheet_link_tag "tailwind", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-paper text-ink">
    <header class="snap-start bg-pitch text-white">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3">
        <%= link_to brand(:name), main_app.root_path, class: "inline-flex min-h-12 items-center font-display text-2xl font-extrabold tracking-tight" %>
        <nav class="flex items-center gap-4 text-sm font-semibold" aria-label="Principal">
          <% if user_signed_in? %>
            <details class="group relative" data-role="account-menu">
              <summary class="flex min-h-12 cursor-pointer list-none items-center gap-1 rounded-sm px-2 hover:bg-white/10 [&::-webkit-details-marker]:hidden">Minha conta<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-fast group-open:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
              <ul class="absolute right-0 z-10 mt-2 flex w-max min-w-[12rem] flex-col rounded-sm border border-rule bg-white py-1 text-ink">
                <li><%= link_to "Minha conta", main_app.account_path, class: "flex min-h-12 items-center px-3 py-2 hover:bg-rule" %></li>
                <li><%= link_to "Meus bolões", main_app.pools_path, class: "flex min-h-12 items-center px-3 py-2 hover:bg-rule" %></li>
                <li><%= link_to "Meu #{module_label(:fantasy).downcase}", main_app.esquadrao_path, class: "flex min-h-12 items-center px-3 py-2 hover:bg-rule" %></li>
                <li><%= link_to "Rankings", main_app.esquadrao_rankings_path, class: "flex min-h-12 items-center px-3 py-2 hover:bg-rule" %></li>
              </ul>
            </details>
            <%= button_to "Sair", main_app.session_path, method: :delete, class: "inline-flex min-h-12 cursor-pointer items-center rounded-sm border border-white px-4 py-2 font-bold transition-colors duration-fast ease-editorial hover:bg-white hover:text-pitch" %>
          <% else %>
            <%= link_to "Entrar", main_app.login_path, class: "inline-flex min-h-12 items-center rounded-sm border border-white px-4 py-2 font-bold transition-colors duration-fast ease-editorial hover:bg-white hover:text-pitch" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-8">
      <%= yield %>
    </main>

    <footer class="snap-end border-t border-rule">
      <% footer_link = inline_link_classes(tone: :ink) %>
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-6 text-sm text-graphite">
        <p>
          © <span class="tabular-nums"><%= Date.current.year %></span> <%= brand(:name) %> ·
          Desenvolvido por <%= link_to brand(:author), brand(:author_url), class: footer_link, rel: "noopener", data: { role: "author-link" } %>
        </p>
        <nav class="flex flex-wrap items-center gap-4" aria-label="Rodapé">
          <%= link_to "GitHub", "https://github.com/LMafra/futebol", class: footer_link, rel: "noopener" %>
          <%= link_to "Documentação", "https://github.com/LMafra/futebol/tree/main/docs", class: footer_link, rel: "noopener" %>
          <%= link_to "Licença MIT", "https://github.com/LMafra/futebol/blob/main/LICENSE", class: footer_link, rel: "noopener" %>
          <% if user_signed_in? && (current_user.admin? || current_user.manager?) %>
            <%= link_to "Área do gestor", main_app.gestor_root_path, class: footer_link %>
          <% end %>
          <% if user_signed_in? && current_user.admin? %>
            <%= link_to "Acesso administrativo", "/admin", class: footer_link %>
          <% elsif !user_signed_in? %>
            <%= link_to "Acesso administrativo", "/admin", class: footer_link %>
          <% end %>
          <details class="group relative" data-role="pix">
            <summary class="flex min-h-12 cursor-pointer list-none items-center gap-1 <%= footer_link %> [&::-webkit-details-marker]:hidden">Pague o Café<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-fast group-open:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
            <div class="absolute bottom-full right-0 z-10 mb-2 flex w-max flex-col gap-2 rounded-md border border-rule bg-white p-4 text-ink" data-controller="clipboard">
              <p class="text-xs font-bold uppercase tracking-widest text-graphite">Chave Pix</p>
              <code class="font-sans text-sm" data-clipboard-target="source"><%= brand(:pix_key) %></code>
              <button type="button" class="<%= secondary_button_classes("self-start", size: :sm) %>"
                      data-action="clipboard#copy" data-clipboard-target="button">Copiar chave</button>
              <span class="sr-only" aria-live="polite" data-clipboard-target="status" data-role="pix-status"></span>
            </div>
          </details>
        </nav>
      </div>
    </footer>
  </body>
</html>
