<div class="mx-auto w-full max-w-md">
  <%= render "shared/flash" %>

  <p class="text-xs font-bold uppercase tracking-widest text-graphite">Acesso</p>
  <h1 class="mt-1 border-b-4 border-ink pb-2 font-display text-4xl font-extrabold tracking-tight">Esqueceu a senha?</h1>

  <%= form_with url: passwords_path, class: "mt-6 flex flex-col gap-4" do |form| %>
    <div>
      <%= form.label :email_address, "E-mail", class: "text-sm font-semibold" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "voce@exemplo.com", value: params[:email_address], class: form_control_classes("mt-1 block w-full") %>
    </div>

    <div>
      <%= form.submit "Enviar instruções", class: primary_button_classes %>
    </div>
  <% end %>
</div>
