<section class="rounded-md bg-night text-white" aria-label="Números do <%= brand(:name) %>" data-role="counters">
  <dl class="grid divide-y divide-graphite md:grid-cols-3 md:divide-x md:divide-y-0">
    <% { championships: "Campeonatos", matches: "Partidas", players: "Jogadores" }.each do |key, label| %>
      <div class="flex flex-col gap-1 px-6 py-6" data-role="counter-<%= key %>">
        <dt class="text-xs font-bold uppercase tracking-widest text-rule"><%= label %></dt>
        <dd class="font-display text-6xl font-extrabold tabular-nums lining-nums"><%= number_with_delimiter(counters.fetch(key), delimiter: ".") %></dd>
      </div>
    <% end %>
  </dl>
</section>
