<section class="flex flex-col gap-6" aria-labelledby="how-title" data-role="how-it-works">
  <h2 id="how-title" class="border-b border-rule pb-2 font-display text-3xl font-extrabold">Como funciona</h2>
  <ol class="grid gap-6 md:grid-cols-3">
    <% [["Crie sua conta", "Nome, e-mail e senha. Seu nome só aparece nos rankings públicos se você autorizar."],
        ["Escolha um campeonato", "Entre num bolão pelo código de convite ou abra um campeonato público para acompanhar."],
        ["Dispute em três modos", "Palpite no Bolão, escale no #{module_label(:fantasy)} e simule a tabela no Simulador."]].each_with_index do |(title, text), index| %>
      <li class="flex flex-col gap-2 border-t-4 border-pitch pt-4">
        <span class="font-display text-4xl font-extrabold tabular-nums text-pitch"><%= index + 1 %></span>
        <h3 class="text-lg font-bold"><%= title %></h3>
        <p class="text-graphite"><%= text %></p>
      </li>
    <% end %>
  </ol>
</section>
