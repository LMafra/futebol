<section class="flex flex-col gap-4" aria-labelledby="today-title" data-role="matches-today" data-controller="scroller" data-scroller-autoplay-value="6000"
         data-action="mouseenter->scroller#hold mouseleave->scroller#release focusin->scroller#hold focusout->scroller#release touchstart->scroller#stop:passive">
  <div class="flex flex-wrap items-end justify-between gap-4 border-b border-rule pb-2">
    <h2 id="today-title" class="font-display text-3xl font-extrabold">Jogos de hoje</h2>
    <% if matches.any? %>
      <div class="flex items-center gap-3">
        <span class="text-sm font-bold text-graphite tabular-nums" data-role="today-count"><%= pluralize(matches.size, "jogo", plural: "jogos") %></span>
        <button type="button" class="<%= secondary_button_classes %>" data-scroller-target="toggle" data-action="scroller#toggle" hidden>Pausar</button>
        <div class="flex gap-2" data-scroller-target="nav" hidden>
          <% [["previous", "Jogos anteriores", "m15 18-6-6 6-6"], ["next", "Próximos jogos", "m9 18 6-6-6-6"]].each do |action, label, path| %>
            <button type="button" class="flex size-12 cursor-pointer items-center justify-center rounded-sm border border-graphite bg-white text-ink hover:border-ink hover:bg-rule"
                    data-action="scroller#<%= action %>" aria-label="<%= label %>">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="<%= path %>"/></svg>
            </button>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
  <% if matches.empty? %>
    <%= empty_notice("Nenhum jogo hoje.") %>
  <% else %>
    <%# The gap is each item's right padding and the list reaches past the right edge by the same amount, so a whole
        number of cards fills the width and the last visible one is never cut. %>
    <ul class="scrollbar-none -mr-3 flex snap-x snap-mandatory overflow-x-auto" aria-label="Jogos de hoje, em ordem de horário" data-scroller-target="list" data-action="scroll->scroller#scrolled">
      <% matches.each do |match| %>
        <li class="flex w-full shrink-0 snap-start pr-3 sm:w-1/2 md:w-1/3 lg:w-1/4" data-role="today-match">
          <%= link_to public_match_path(match), data: { live: match.live? },
                      class: "group flex w-full flex-col gap-2 rounded-md border bg-white px-4 py-3 transition-colors duration-fast ease-editorial hover:border-ink hover:bg-rule #{match.live? ? 'border-cartola' : 'border-rule'}" do %>
            <span class="truncate text-xs font-bold uppercase tracking-widest text-pitch group-hover:underline" data-role="today-match-championship"><%= match.championship.name %></span>
            <span class="flex items-center justify-between text-xs font-bold uppercase tracking-widest text-graphite">
              <% if match.live? %>
                <span class="rounded-sm bg-cartola px-2 py-1 text-ink" data-role="live-chip"><%= Ui::ScoreboardComponent::STATUS_LABELS.fetch(match.status) %></span>
              <% else %>
                <span><%= Ui::ScoreboardComponent::STATUS_LABELS.fetch(match.status, match.status) %></span>
              <% end %>
              <span class="tabular-nums"><%= l(match.match_date, format: "%H:%M") %></span>
            </span>
            <% [[match.home_team, match.home_score], [match.away_team, match.away_score]].each do |team, score| %>
              <span class="flex items-center justify-between gap-4 font-semibold">
                <span><%= team.name %></span>
                <span class="tabular-nums"><%= score || "–" %></span>
              </span>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
