<section class="max-w-3xl">
  <%= render "shared/flash" %>

  <p class="text-xs font-bold uppercase tracking-widest text-graphite">Rodada</p>
  <h1 class="mt-1 border-b-4 border-ink pb-2 font-display text-4xl font-extrabold tracking-tight">Futebol</h1>
  <p class="mt-4">Conectado como <%= current_user.email_address %>.</p>
  <%= link_to "Meus bolões", pools_path, class: "mt-4 inline-block font-semibold text-pitch underline underline-offset-2 hover:no-underline" %>
  <%= button_to "Sair", session_path, method: :delete, class: "mt-6 cursor-pointer text-graphite underline underline-offset-2 hover:no-underline" %>
</section>
