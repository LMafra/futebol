<section class="grid gap-8 border-b-4 border-ink pb-12 md:grid-cols-admin" aria-labelledby="hero-title" data-role="hero">
  <div class="flex flex-col gap-4 md:col-span-8">
    <p class="text-xs font-bold uppercase tracking-widest text-graphite">Bolão · <%= module_label(:fantasy) %> · Simulador</p>
    <h1 id="hero-title" class="font-display text-6xl font-extrabold tracking-tight md:text-8xl"><%= brand(:name) %></h1>
    <p class="font-display text-2xl font-semibold md:text-4xl"><%= brand(:tagline) %></p>
    <p class="max-w-2xl text-lg text-graphite">
      Palpite nos jogos com os amigos, escale seu time da rodada com moedas e simule a tabela antes do apito final.
    </p>
  </div>
  <div class="flex flex-col justify-end gap-3 md:col-span-4" data-role="hero-actions">
    <% if user_signed_in? %>
      <p class="text-sm font-semibold text-graphite">Continue de onde parou</p>
      <%= link_to "Meus bolões", pools_path, class: secondary_button_classes(size: :lg) %>
      <%= link_to "Meu #{module_label(:fantasy).downcase}", esquadrao_path, class: secondary_button_classes(size: :lg) %>
      <%= link_to "Simulador", simulador_path, class: secondary_button_classes(size: :lg) %>
    <% else %>
      <%= link_to "Entrar", login_path, class: primary_button_classes(size: :lg) %>
      <%= link_to "Criar conta", signup_path, class: secondary_button_classes(size: :lg) %>
    <% end %>
  </div>
</section>
