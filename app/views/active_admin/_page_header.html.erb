<%# Placar page header — replaces AA default gray-50 bar. %>
<div data-test-page-header class="mb-8 flex flex-col justify-between gap-4 border-b border-rule bg-paper p-4 md:flex-row md:items-center">
  <div class="flex flex-col gap-3 pt-1">
    <% breadcrumb_links = build_breadcrumb_links(request.path, class: inline_link_classes('font-body')) %>
    <% if breadcrumb_links.present? %>
      <nav aria-label="breadcrumb">
        <ol class="flex flex-wrap gap-1 text-sm font-body">
          <% breadcrumb_links.each_with_index do |link, index| %>
            <li class="inline-flex h-5 items-center gap-1">
              <% if index > 0 %>
                <svg class="h-5 w-5 shrink-0 text-rule rtl:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
                </svg>
              <% end %>
              <%= link %>
            </li>
          <% end %>
        </ol>
      </nav>
    <% end %>
    <h2 class="font-display text-2xl font-semibold text-ink"><%= title %></h2>
  </div>
  <% if action_items_for_action.present? %>
    <div data-test-action-items class="flex flex-wrap gap-2 lg:justify-end">
      <%= render 'active_admin/shared/action_items' %>
    </div>
  <% end %>
</div>
