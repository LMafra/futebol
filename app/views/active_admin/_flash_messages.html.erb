<% if flash_messages.present? %>
  <div class="mb-8 px-2.5 lg:px-5" data-role="craquefy-admin-flashes">
    <% flash_messages.each do |type, message| %>
      <% if type == 'error' %>
        <div class="mb-2 flex items-center gap-3 rounded-md border border-ink bg-loss p-4 font-body text-ink" role="alert">
          <svg class="h-5 w-5 shrink-0 text-ink" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20"><path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM10 15a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm1-4a1 1 0 0 1-2 0V6a1 1 0 0 1 2 0v5Z"/></svg>
          <%= message %>
        </div>
      <% elsif type == 'alert' %>
        <div class="mb-2 flex items-center gap-3 rounded-md border border-cartola/30 bg-cartola/10 p-4 font-body text-ink" role="status">
          <svg class="h-5 w-5 shrink-0 text-cartola" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20"><path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/></svg>
          <%= message %>
        </div>
      <% elsif type == 'notice' %>
        <div class="mb-2 flex items-center gap-3 rounded-md border border-pitch/30 bg-pitch/10 p-4 font-body text-ink" role="status">
          <svg class="h-5 w-5 shrink-0 text-pitch" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20"><path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z"/></svg>
          <%= message %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
