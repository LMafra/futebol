<%= render Ui::EmptyStateComponent.new(
      title: I18n.t('active_admin.blank_slate.content', resource_name: active_admin_config.plural_resource_label),
      description: 'Nada cadastrado ainda nesta lista.'
    ) do |empty| %>
  <% empty.with_action do %>
    <% if new_action_authorized?(active_admin_config.resource_class) %>
      <%= if page_presenter.options.has_key?(:blank_slate_link)
            link = page_presenter.options[:blank_slate_link]
            instance_exec(&link) if link.is_a?(Proc)
          else
            link_to(I18n.t('active_admin.blank_slate.link'), new_resource_path, class: AdminHelper::ADMIN_BUTTON_CLASSES)
          end
      %>
    <% end %>
  <% end %>
<% end %>
