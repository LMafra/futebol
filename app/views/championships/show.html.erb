<% content_for(:title, brand_title("#{@championship}")) %>

<div class="flex max-w-4xl flex-col gap-6">
  <header class="flex flex-wrap items-end justify-between gap-4 border-b-4 border-ink pb-2">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-graphite">Campeonato · Temporada <span class="tabular-nums"><%= @championship.season %></span></p>
      <h1 class="mt-1 font-display text-4xl font-extrabold tracking-tight"><%= @championship.name %></h1>
    </div>
    <%= link_to "Simular", main_app.simulador_championship_path(@championship), data: { role: "simulate-championship" },
                class: "rounded-sm border-2 border-ink px-4 py-2 font-bold transition-colors duration-fast ease-editorial hover:bg-ink hover:text-white" %>
  </header>

  <nav class="flex flex-wrap gap-2" aria-label="Seções do campeonato" role="tablist">
    <% ChampionshipsController::TABS.each do |tab, label| %>
      <%= link_to label, public_championship_path(@championship, tab:), role: "tab", data: { role: "championship-tab" },
                  aria: { selected: tab == @tab, current: (tab == @tab ? "page" : nil) },
                  class: "rounded-sm border px-3 py-2 font-semibold #{tab == @tab ? 'border-cartola bg-cartola text-ink' : 'border-rule hover:bg-paper'}" %>
    <% end %>
  </nav>

  <%= render ChampionshipsController::PARTIALS.fetch(@tab) %>
</div>
