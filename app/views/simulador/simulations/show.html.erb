<% content_for(:title, "Simulador · #{@championship} · Futebol") %>

<div class="flex flex-col gap-8">
  <header class="flex flex-wrap items-end justify-between gap-4 border-b-4 border-ink pb-2">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-graphite">Simulador · <%= @championship %></p>
      <h1 class="mt-1 font-display text-4xl font-extrabold tracking-tight">E se…?</h1>
      <p class="mt-2 max-w-2xl text-graphite">Preencha placares dos jogos que faltam e veja como a tabela ficaria. Nada é salvo; jogos sem placar ficam de fora.</p>
    </div>
    <% if @championships.size > 1 %>
      <%= form_with url: main_app.simulador_path, method: :get, class: "flex items-center gap-2 text-sm font-semibold", data: { turbo: false } do %>
        <%= label_tag :championship_id, "Campeonato" %>
        <%= select_tag :championship_id, options_from_collection_for_select(@championships, :id, :to_s, @championship.id),
                       class: "rounded-sm border border-rule px-2 py-1" %>
        <button type="submit" class="cursor-pointer rounded-sm border border-ink px-3 py-1 hover:bg-ink hover:text-white">Ver</button>
      <% end %>
    <% end %>
  </header>

  <div class="grid gap-8 lg:grid-cols-2">
    <section aria-labelledby="real-table-title">
      <h2 id="real-table-title" class="mb-3 font-display text-2xl font-extrabold">Tabela atual</h2>
      <%= render Ui::StandingsTableComponent.new(rows: simulador_rows(@real, @teams), zones: true,
                                                 empty_message: "Nenhum jogo encerrado ainda.") %>
    </section>

    <%= render "simulador/simulations/simulator", championship: @championship, open_matches: @open_matches,
                                                   simulation: @simulation, raw: {}, projected: nil, teams: @teams %>
  </div>
</div>
