<% content_for(:title, brand_title("Simulador · #{@championship}")) %>

<div class="flex flex-col gap-8">
  <header class="flex flex-wrap items-end justify-between gap-4 border-b-4 border-ink pb-2">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-graphite">Simulador · <%= @championship %></p>
      <h1 class="mt-1 font-display text-4xl font-extrabold tracking-tight">E se…?</h1>
      <p class="mt-2 max-w-2xl text-graphite">Preencha placares dos jogos que faltam e veja como a tabela ficaria. Nada é salvo; jogos sem placar ficam de fora.</p>
    </div>
    <nav class="flex flex-wrap items-center gap-4 text-sm font-semibold" aria-label="Navegação do simulador" data-role="simulator-nav">
      <% unless @championship.private? %>
        <%= link_to "Ver campeonato", main_app.public_championship_path(@championship), class: "text-pitch underline underline-offset-2 hover:no-underline" %>
      <% end %>
      <%= link_to "Outros campeonatos", main_app.simulador_path, class: "text-pitch underline underline-offset-2 hover:no-underline" %>
    </nav>
  </header>

  <div class="grid gap-8 lg:grid-cols-2">
    <section aria-labelledby="real-table-title">
      <h2 id="real-table-title" class="mb-3 font-display text-2xl font-extrabold">Tabela atual</h2>
      <%= render Ui::StandingsTableComponent.new(rows: simulador_rows(@real, @teams), zones: true,
                                                 empty_message: "Nenhum jogo encerrado ainda.") %>
    </section>

    <%= render "simulador/simulations/simulator", championship: @championship, matches: @matches,
                                                   open_matches: @open_matches, simulation: @simulation, raw: {},
                                                   projected: nil, teams: @teams, round_index: nil %>
  </div>
</div>
