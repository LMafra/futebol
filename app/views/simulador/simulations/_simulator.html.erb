<%= turbo_frame_tag "simulador", class: "grid gap-8 lg:grid-cols-2" do %>
  <section aria-labelledby="table-title" data-role="<%= projected ? "projection" : "real-table" %>">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-4">
      <h2 id="table-title" class="font-display text-2xl font-extrabold"><%= projected ? "Tabela projetada" : "Tabela atual" %></h2>
      <% if simulated %>
        <%= link_to main_app.simulador_championship_path(championship), data: { role: "reset-simulation" },
                    class: secondary_button_classes(size: :sm) do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          Zerar simulação
        <% end %>
      <% end %>
    </div>
    <% if projected %>
      <%= render Ui::StandingsTableComponent.new(rows: simulador_rows(projected, teams), zones: true,
                                                 empty_message: "Preencha algum placar para projetar.") %>
    <% else %>
      <%= render Ui::StandingsTableComponent.new(rows: simulador_rows(real, teams), zones: true,
                                                 empty_message: "Nenhum jogo encerrado ainda.") %>
    <% end %>
  </section>

  <section class="flex flex-col gap-6" aria-labelledby="simulator-title">
    <h2 id="simulator-title" class="font-display text-2xl font-extrabold">Rodadas</h2>

    <% if simulation.errors.any? %>
      <div class="<%= error_classes("flex flex-col gap-1") %>" role="alert" data-role="simulation-errors">
        <span class="font-bold">Revise os placares marcados.</span>
        <% simulation.errors.each do |match_id, message| %>
          <span>Partida <%= match_id %>: <%= message %></span>
        <% end %>
      </div>
    <% end %>

    <% if open_matches.empty? %>
      <%= empty_notice("Todos os jogos deste campeonato já foram encerrados.") %>
    <% end %>
    <% if matches.any? %>
      <% rounds = matches.group_by(&:round).to_a %>
      <% start_index = simulador_round_index(rounds, simulation, round_index) %>
      <%= form_with url: main_app.simulador_preview_path(championship), method: :post, class: "flex flex-col gap-4",
                    data: { controller: "rounds", rounds_index_value: start_index } do %>
        <%= hidden_field_tag :round_index, start_index, data: { rounds_target: "position" } %>
        <div class="flex items-center justify-between gap-2" data-rounds-target="nav" data-role="rounds-nav" hidden>
          <button type="button" class="<%= secondary_button_classes(size: :sm) %>"
                  data-action="rounds#previous" data-rounds-target="previous" aria-label="Rodada anterior">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            Anterior
          </button>
          <p class="text-center text-sm font-bold" aria-live="polite" data-rounds-target="label"></p>
          <button type="button" class="<%= secondary_button_classes(size: :sm) %>"
                  data-action="rounds#next" data-rounds-target="next" aria-label="Próxima rodada">
            Próxima
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
        <% rounds.each do |round, round_matches| %>
          <% round_label = round ? "Rodada #{round}" : "Sem rodada" %>
          <% open_round = round_matches.any? { |match| simulador_open?(match) } %>
          <fieldset class="rounded-md border border-rule bg-white p-4" data-rounds-target="round" data-round-label="<%= round_label %>"
                    data-role="<%= open_round ? "open-round" : "closed-round" %>">
            <legend class="px-1 text-xs font-bold uppercase tracking-widest text-graphite"><%= round_label %><%= " · encerrada" unless open_round %></legend>
            <ul class="flex flex-col gap-2">
              <% round_matches.each do |match| %>
                <% unless simulador_open?(match) %>
                  <li class="grid grid-cols-[1fr_auto_1fr] items-center gap-2 text-sm" data-role="closed-match" data-match-id="<%= match.id %>">
                    <span class="truncate text-right font-semibold"><%= match.home_team.name %></span>
                    <span class="flex items-center gap-1 font-bold tabular-nums" aria-hidden="true">
                      <span class="w-12 text-center"><%= match.home_score || "–" %></span>×<span class="w-12 text-center"><%= match.away_score || "–" %></span>
                    </span>
                    <span class="sr-only">Placar final: <%= match.home_score %> a <%= match.away_score %></span>
                    <span class="truncate font-semibold"><%= match.away_team.name %></span>
                  </li>
                  <% next %>
                <% end %>
                <% error = simulation.errors[match.id.to_s] %>
                <li class="grid grid-cols-[1fr_auto_1fr] items-center gap-2 text-sm" data-role="open-match" data-match-id="<%= match.id %>">
                  <span class="flex min-w-0 items-center justify-end gap-1 font-semibold"><span class="truncate"><%= match.home_team.name %></span><% if match.live? %><span class="shrink-0 rounded-sm bg-cartola px-1 text-xs font-bold text-ink" data-role="live-chip">AO VIVO</span><% end %></span>
                  <span class="flex items-center gap-1 tabular-nums">
                    <%= number_field_tag "guesses[#{match.id}][home]", simulador_goals(simulation, raw, match, :home), min: 0, max: 99,
                                         class: form_control_classes("w-16 text-center", invalid: error.present?),
                                         aria: { label: "Gols do #{match.home_team.name}", invalid: error.present? || nil,
                                                 describedby: ("simulador-error-#{match.id}" if error) } %>
                    <span aria-hidden="true">×</span>
                    <%= number_field_tag "guesses[#{match.id}][away]", simulador_goals(simulation, raw, match, :away), min: 0, max: 99,
                                         class: form_control_classes("w-16 text-center", invalid: error.present?),
                                         aria: { label: "Gols do #{match.away_team.name}", invalid: error.present? || nil,
                                                 describedby: ("simulador-error-#{match.id}" if error) } %>
                  </span>
                  <span class="truncate font-semibold"><%= match.away_team.name %></span>
                  <% if error %>
                    <span id="simulador-error-<%= match.id %>" class="col-span-3 text-center text-xs font-bold text-ink" data-role="field-error"><%= error %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </fieldset>
        <% end %>
        <% if open_matches.any? %>
          <button type="submit" class="<%= primary_button_classes("self-start") %>">Projetar tabela</button>
        <% end %>
      <% end %>
    <% end %>
  </section>
<% end %>
